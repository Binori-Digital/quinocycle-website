---
import Layout from '../../layouts/Layout.astro';

const CITY = 'Kuala Lumpur';
const WA_NUMBER = '60168916381';
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(`Hi Quinocycle! Saya nak beli kotak pindah rumah di ${CITY}.`)}`;

const faqs = [
  {
    q: 'Di mana nak beli kotak pindah rumah murah di Kuala Lumpur?',
    a: 'Tak perlu ke kedai — Quinocycle menghantar terus ke seluruh KL: Cheras, Bukit Jalil, Sri Petaling, Old Klang Road, Setapak, Wangsa Maju, Mont Kiara dan Bangsar. Harga borong dari RM0.90 sekotak, penghantaran percuma untuk pesanan melebihi RM300. Kalau nak ambil sendiri, gudang kami di Taming Jaya, Balakong — ±30 minit memandu dari pusat bandar KL.',
  },
  {
    q: 'Kenapa harga kotak di kedai KL sampai RM8-RM12 sekotak?',
    a: 'Kedai runcit dan kedai hardware di KL menanggung sewa lot kedai dan margin orang tengah, jadi kotak yang sama dijual RM8 hingga RM12. Quinocycle ialah pembekal borong — kami jual terus dari gudang: kotak terpakai dari RM0.90, kotak baru dari RM1.10 sekotak, dihantar ke depan pintu anda.',
  },
  {
    q: 'Berapa lama penghantaran kotak ke kawasan Kuala Lumpur?',
    a: 'KL sangat dekat dengan gudang kami di Balakong, jadi penghantaran biasanya cepat — WhatsApp senarai saiz dan kuantiti anda ke 016-891 6381, dan kami aturkan slot penghantaran. Percuma untuk pesanan melebihi RM300 di KL & Selangor.',
  },
  {
    q: 'Saya duduk kondo di KL — berapa kotak perlu untuk pindah?',
    a: 'Anggaran biasa: unit atau rumah 3 bilik perlukan 50-70 kotak (bilik tidur 10-15, dapur 15-20, ruang tamu 8-12, bilik air 3-5). Untuk kuantiti pindah rumah yang lebih kecil daripada minimum borong RM1,000, WhatsApp kami untuk sebut harga terus.',
  },
];

const storeSchema = {
  "@context": "https://schema.org",
  "@type": "Store",
  "name": `Quinocycle — Kotak Pindah Rumah ${CITY}`,
  "description": `Pembekal kotak pindah rumah untuk ${CITY}. Kotak kardus baru dan terpakai harga borong dari RM0.90 sekotak — penghantaran ke seluruh KL, percuma untuk pesanan RM300+. Gudang di Balakong, Selangor.`,
  "url": "https://www.quinocycle.com.my/kotak-pindah-rumah/kuala-lumpur/",
  "telephone": "+60168916381",
  "priceRange": "RM0.90 - RM8.00 sekotak",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "No.13, Jalan Taming P/1, Taming Jaya",
    "addressLocality": "Balakong",
    "addressRegion": "Selangor",
    "postalCode": "43300",
    "addressCountry": "MY"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 3.0579, "longitude": 101.7468 },
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "17:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "09:00", "closes": "13:00" }
  ],
  "areaServed": ["Kuala Lumpur","Cheras","Bukit Jalil","Sri Petaling","Old Klang Road","Setapak","Wangsa Maju","Mont Kiara","Bangsar"]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://www.quinocycle.com.my/" },
    { "@type": "ListItem", "position": 2, "name": "Kotak Pindah Rumah", "item": "https://www.quinocycle.com.my/kotak-pindah-rumah/" },
    { "@type": "ListItem", "position": 3, "name": CITY, "item": "https://www.quinocycle.com.my/kotak-pindah-rumah/kuala-lumpur/" }
  ]
};
---

<Layout
  lang="ms"
  title={`Kotak Pindah Rumah ${CITY} — Harga Borong Dihantar ke Pintu, dari RM0.90 | Quinocycle`}
  description={`Kotak pindah rumah dihantar ke seluruh ${CITY} — Cheras, Bukit Jalil, Setapak, Mont Kiara. Harga borong dari RM0.90 sekotak, percuma untuk order RM300+. WhatsApp 016-891 6381.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(storeSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="pt-16 pb-12 px-6 md:px-8 max-w-7xl mx-auto">
    <nav class="font-body text-xs text-secondary mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary transition-colors">Utama</a>
      <span class="mx-2">/</span>
      <a href="/kotak-pindah-rumah" class="hover:text-primary transition-colors">Kotak Pindah Rumah</a>
      <span class="mx-2">/</span>
      <span class="text-on-surface font-semibold">{CITY}</span>
    </nav>
    <span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4 block">Penghantaran Ke Seluruh KL</span>
    <h1 class="font-headline text-4xl md:text-6xl font-extrabold tracking-tighter text-on-surface leading-[0.95] mb-6 max-w-4xl">
      Kotak pindah rumah {CITY} <br /><span class="text-primary italic">— harga borong, hantar ke pintu.</span>
    </h1>
    <p class="font-body text-lg md:text-xl text-secondary max-w-2xl leading-relaxed mb-8">
      Di KL, kotak yang sama dijual RM8–RM12 di kedai runcit dan mall. Quinocycle ialah pembekal borong dari <strong class="text-on-surface font-semibold">Balakong — ±30 minit dari pusat bandar</strong> — jadi anda dapat kotak terpakai dari <strong class="text-on-surface font-semibold">RM0.90</strong> dan kotak baru dari <strong class="text-on-surface font-semibold">RM1.10</strong> sekotak, dihantar terus ke kondo atau rumah anda. Percuma untuk pesanan melebihi RM300.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-[#25D366] text-white px-8 py-3.5 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:bg-[#1ebd5a] transition-colors">
        WhatsApp Sekarang
      </a>
      <a href="/kotak-pindah-rumah#senarai-harga" class="bg-primary-container text-on-primary-container px-8 py-3.5 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-all">
        Senarai Harga Penuh
      </a>
    </div>
  </section>

  <!-- Local info -->
  <section class="py-16 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-6 md:px-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-surface rounded-3xl p-8">
        <span class="material-symbols-outlined text-3xl text-primary mb-3 block">local_shipping</span>
        <h2 class="font-headline font-bold text-lg text-on-surface mb-3">Hantar Ke Seluruh KL</h2>
        <p class="font-body text-sm text-secondary leading-relaxed">
          Cheras, Bukit Jalil, Sri Petaling, Old Klang Road, Setapak, Wangsa Maju, Mont Kiara, Bangsar — semua kawasan KL kami cover. Penghantaran percuma untuk pesanan melebihi RM300 (KL &amp; Selangor).
        </p>
      </div>
      <div class="bg-surface rounded-3xl p-8">
        <span class="material-symbols-outlined text-3xl text-primary mb-3 block">storefront</span>
        <h2 class="font-headline font-bold text-lg text-on-surface mb-3">Atau Ambil Sendiri</h2>
        <p class="font-body text-sm text-secondary leading-relaxed">
          Gudang kami di No.13, Jalan Taming P/1, Taming Jaya, 43300 Balakong — ±30 minit memandu dari pusat bandar KL. WhatsApp senarai kotak anda dulu, kami siapkan sebelum anda sampai.
        </p>
      </div>
      <div class="bg-surface rounded-3xl p-8">
        <span class="material-symbols-outlined text-3xl text-primary mb-3 block">schedule</span>
        <h2 class="font-headline font-bold text-lg text-on-surface mb-3">Waktu Operasi</h2>
        <p class="font-body text-sm text-secondary leading-relaxed">
          Isnin–Jumaat: 9:00 pagi – 5:00 petang<br />
          Sabtu: 9:00 pagi – 1:00 tengah hari<br />
          Ahad &amp; cuti umum: tutup (WhatsApp tetap dibalas)
        </p>
      </div>
    </div>
  </section>

  <!-- Content block -->
  <section class="py-20 px-6 md:px-8 max-w-3xl mx-auto">
    <h2 class="font-headline text-3xl md:text-4xl font-extrabold tracking-tighter text-on-surface mb-6">Kenapa penduduk Kuala Lumpur order kotak dari kami?</h2>
    <div class="font-body text-secondary leading-relaxed flex flex-col gap-5 text-base md:text-lg">
      <p>
        Nak pindah rumah di KL memang mencabar — dan mencari kotak yang berkualiti pada harga berpatutan adalah salah satu masalahnya. Kebanyakan kedai yang jual kotak di KL ialah kedai runcit dalam mall atau kedai hardware, dan harganya <strong class="text-on-surface font-semibold">RM8 hingga RM12 untuk satu kotak</strong>. Untuk pindah rumah 3 bilik yang perlukan 50–70 kotak, itu bermakna RM400 hingga RM800 hanya untuk kotak kosong — lihat <a href="/blog/harga-kotak-pindah-rumah" class="text-primary font-semibold hover:underline">perbandingan harga kotak pindah rumah</a> untuk angka penuh.
      </p>
      <p>
        Quinocycle ialah pembekal borong yang membekalkan kotak kepada syarikat mover dan penjual online di seluruh Lembah Klang. Gudang kami di Balakong hanya ±30 minit dari pusat bandar KL — cukup dekat untuk hantar kotak yang sama <strong class="text-on-surface font-semibold">terus ke depan pintu anda pada harga borong</strong>: <a href="/used-carton-boxes" class="text-primary font-semibold hover:underline">kotak terpakai gred sekali guna</a> (disemak, kering, tiada bau) dari RM0.90, <a href="/shop" class="text-primary font-semibold hover:underline">kotak baru</a> dari RM1.10 sekotak. Baca <a href="/blog/beza-kotak-baru-kotak-terpakai" class="text-primary font-semibold hover:underline">perbezaan kotak baru dan kotak terpakai</a> untuk pilih yang sesuai dengan bajet anda.
      </p>
      <p>
        Sama ada anda duduk kondo di Bukit Jalil atau Sri Petaling, rumah teres di Cheras KL atau Setapak, apartmen di Wangsa Maju, atau unit servis di Mont Kiara dan Bangsar — sistemnya sama: WhatsApp senarai saiz dan kuantiti, dapat sebut harga, dan kotak sampai ke lobi atau porch anda. Tak perlu sumbat 60 kotak dalam kereta, tak perlu cari parking di mall. Penduduk Old Klang Road dan Cheras KL yang nak jimat lagi boleh terus ambil sendiri di gudang Balakong.
      </p>
      <p>
        Penghantaran percuma untuk pesanan melebihi RM300 di KL &amp; Selangor — kebanyakan pesanan pindah rumah penuh layak secara automatik. Semak <a href="/kotak-pindah-rumah" class="text-primary font-semibold hover:underline">senarai harga penuh kotak pindah rumah</a>, kira keperluan anda dengan <a href="/blog/berapa-kotak-diperlukan-pindah-rumah" class="text-primary font-semibold hover:underline">panduan berapa kotak diperlukan</a>, atau baca <a href="/blog/tips-pindah-rumah-packing-malaysia" class="text-primary font-semibold hover:underline">tips packing pindah rumah</a> sebelum mula mengemas.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-surface-container-low">
    <div class="max-w-3xl mx-auto px-6 md:px-8">
      <h2 class="font-headline text-3xl font-extrabold tracking-tighter text-on-surface mb-8">Soalan lazim — kotak pindah {CITY}</h2>
      <div class="flex flex-col divide-y divide-outline-variant/15">
        {faqs.map(f => (
          <details class="group py-5">
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-headline font-bold text-lg text-on-surface">
              {f.q}
              <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-45 flex-shrink-0" style="font-size:24px;">add</span>
            </summary>
            <p class="font-body text-sm text-secondary leading-relaxed mt-3">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Nearby areas -->
  <section class="py-16 px-6 md:px-8 max-w-7xl mx-auto">
    <h2 class="font-headline text-2xl font-extrabold tracking-tighter text-on-surface mb-6">Kawasan berdekatan</h2>
    <div class="flex flex-wrap gap-3">
      <a href="/kotak-pindah-rumah/cheras"         class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Kotak Pindah Cheras</a>
      <a href="/kotak-pindah-rumah/puchong"        class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Kotak Pindah Puchong</a>
      <a href="/kotak-pindah-rumah/seri-kembangan" class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Kotak Pindah Seri Kembangan</a>
      <a href="/kotak-pindah-rumah"                class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Semua Kawasan →</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-primary-container text-on-primary-container">
    <div class="max-w-4xl mx-auto px-6 md:px-8 text-center">
      <h2 class="font-headline text-4xl md:text-5xl font-extrabold tracking-tighter mb-6">Kotak sampai KL, anda tak perlu keluar rumah.</h2>
      <p class="font-body text-lg mb-10 opacity-90 max-w-xl mx-auto leading-relaxed">
        Hantar senarai saiz dan kuantiti kotak anda ke WhatsApp — kami balas dengan sebut harga borong dan aturkan penghantaran ke mana-mana kawasan Kuala Lumpur.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="bg-[#25D366] text-white px-10 py-4 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:bg-[#1ebd5a] transition-colors">
          WhatsApp 016-891 6381
        </a>
        <a href="https://www.google.com/maps/search/?api=1&query=Quinocycle+No.13+Jalan+Taming+P%2F1+Taming+Jaya+43300+Balakong+Selangor" target="_blank" rel="noopener noreferrer" class="bg-on-surface text-surface px-10 py-4 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-colors">
          Buka Google Maps
        </a>
      </div>
    </div>
  </section>
</Layout>
