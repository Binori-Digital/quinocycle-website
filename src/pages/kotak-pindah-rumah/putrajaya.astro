---
import Layout from '../../layouts/Layout.astro';

const CITY = 'Putrajaya';
const WA_NUMBER = '60168916381';
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(`Hi Quinocycle! Saya nak beli kotak pindah rumah di ${CITY}.`)}`;

const faqs = [
  {
    q: 'Adakah Quinocycle ada kedai di Putrajaya?',
    a: 'Tiada — gudang kami di No.13, Jalan Taming P/1, Taming Jaya, 43300 Balakong, Selangor, lebih kurang ±25-30 minit memandu dari Putrajaya. Untuk penduduk Putrajaya, cara paling mudah ialah penghantaran: WhatsApp senarai saiz dan kuantiti, kami hantar terus ke presint anda. Ambil sendiri di Balakong juga dialu-alukan.',
  },
  {
    q: 'Berapa lama penghantaran kotak ke Presint 8 hingga Presint 18?',
    a: 'Untuk kawasan Lembah Klang termasuk semua presint kediaman Putrajaya dan Cyberjaya, penghantaran selalunya mengambil 1-2 hari bekerja selepas pesanan disahkan. Penghantaran percuma untuk pesanan melebihi RM300. WhatsApp 016-891 6381 untuk semak slot penghantaran terkini.',
  },
  {
    q: 'Saya bertukar posting — berapa kotak perlu untuk kuarters atau apartmen saya?',
    a: 'Anggaran biasa: rumah atau kuarters 3 bilik perlukan 50-70 kotak (bilik tidur 10-15, dapur 15-20, ruang tamu 8-12, bilik air 3-5). Pesanan borong penuh bermula RM1,000, tetapi untuk kuantiti pindah rumah yang lebih kecil, hantar sahaja senarai anda melalui WhatsApp dan kami berikan sebut harga terus.',
  },
  {
    q: 'Kotak terpakai tu bersih dan kukuh ke untuk pindah rumah?',
    a: 'Ya. Kotak terpakai kami gred sekali guna dari kilang — setiap satu disemak, kering dan bebas bau sebelum dijual. Harganya dari RM0.90 sekotak berbanding kotak baru dari RM1.10, jadi ramai pelanggan Putrajaya campurkan kedua-duanya: terpakai untuk buku dan pakaian, baru untuk barang pecah belah.',
  },
];

const storeSchema = {
  "@context": "https://schema.org",
  "@type": "Store",
  "name": `Quinocycle — Kotak Pindah Rumah ${CITY}`,
  "description": `Pembekal kotak pindah rumah untuk ${CITY}: 18 jenis kotak kardus baru dan terpakai dari RM0.90 sekotak, dihantar ke semua presint dari gudang kami di Balakong, Selangor.`,
  "url": "https://www.quinocycle.com.my/kotak-pindah-rumah/putrajaya/",
  "telephone": "+60168916381",
  "priceRange": "RM0.90 - RM8.00 sekotak",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "No.13, Jalan Taming P/1, Taming Jaya",
    "addressLocality": "Balakong",
    "addressRegion": "Selangor",
    "postalCode": "43300",
    "addressCountry": "MY"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 3.0579, "longitude": 101.7468 },
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "18:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "09:00", "closes": "13:00" }
  ],
  "areaServed": ["Putrajaya","Presint 8","Presint 9","Presint 11","Presint 14","Presint 15","Presint 16","Presint 18","Cyberjaya"]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://www.quinocycle.com.my/" },
    { "@type": "ListItem", "position": 2, "name": "Kotak Pindah Rumah", "item": "https://www.quinocycle.com.my/kotak-pindah-rumah/" },
    { "@type": "ListItem", "position": 3, "name": CITY, "item": "https://www.quinocycle.com.my/kotak-pindah-rumah/putrajaya/" }
  ]
};
---

<Layout
  lang="ms"
  title={`Kotak Pindah Rumah ${CITY} — Penghantaran ke Semua Presint, dari RM0.90 | Quinocycle`}
  description={`Kotak pindah rumah untuk ${CITY}: 18 jenis kotak baru & terpakai dari RM0.90 sekotak, dihantar ke Presint 8-18 & Cyberjaya. Percuma order RM300+. WhatsApp 016-891 6381.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(storeSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="pt-16 pb-12 px-6 md:px-8 max-w-7xl mx-auto">
    <nav class="font-body text-xs text-secondary mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary transition-colors">Utama</a>
      <span class="mx-2">/</span>
      <a href="/kotak-pindah-rumah" class="hover:text-primary transition-colors">Kotak Pindah Rumah</a>
      <span class="mx-2">/</span>
      <span class="text-on-surface font-semibold">{CITY}</span>
    </nav>
    <span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4 block">Penghantaran Ke Seluruh Putrajaya</span>
    <h1 class="font-headline text-4xl md:text-6xl font-extrabold tracking-tighter text-on-surface leading-[0.95] mb-6 max-w-4xl">
      Kotak pindah rumah {CITY} <br /><span class="text-primary italic">— dihantar ke presint anda.</span>
    </h1>
    <p class="font-body text-lg md:text-xl text-secondary max-w-2xl leading-relaxed mb-8">
      Bertukar posting? Tamat kontrak sewa? Jangan bazir masa cari kotak sekitar bandar. Quinocycle ialah pembekal borong dengan <strong class="text-on-surface font-semibold">gudang sebenar di Balakong</strong> — 18 jenis kotak sentiasa dalam stok, kotak terpakai dari <strong class="text-on-surface font-semibold">RM0.90</strong> dan kotak baru dari <strong class="text-on-surface font-semibold">RM1.10</strong> sekotak, dihantar terus ke mana-mana presint di {CITY}.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-[#25D366] text-white px-8 py-3.5 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:bg-[#1ebd5a] transition-colors">
        WhatsApp Sekarang
      </a>
      <a href="/kotak-pindah-rumah#senarai-harga" class="bg-primary-container text-on-primary-container px-8 py-3.5 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-all">
        Senarai Harga Penuh
      </a>
    </div>
  </section>

  <!-- Local info -->
  <section class="py-16 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-6 md:px-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-surface rounded-3xl p-8">
        <span class="material-symbols-outlined text-3xl text-primary mb-3 block">local_shipping</span>
        <h2 class="font-headline font-bold text-lg text-on-surface mb-3">Hantar Ke Semua Presint</h2>
        <p class="font-body text-sm text-secondary leading-relaxed">
          Presint 8, 9, 11, 14, 15, 16, 18 dan seluruh kawasan kediaman Putrajaya — termasuk Cyberjaya bersebelahan. Selalunya 1–2 hari bekerja, dan percuma untuk pesanan melebihi RM300.
        </p>
      </div>
      <div class="bg-surface rounded-3xl p-8">
        <span class="material-symbols-outlined text-3xl text-primary mb-3 block">storefront</span>
        <h2 class="font-headline font-bold text-lg text-on-surface mb-3">Ambil Sendiri di Gudang</h2>
        <p class="font-body text-sm text-secondary leading-relaxed">
          Nak pilih kotak depan mata? Gudang kami di No.13, Jalan Taming P/1, Taming Jaya, 43300 Balakong — ±25–30 minit memandu dari Putrajaya. WhatsApp dulu supaya pesanan siap bila anda tiba.
        </p>
      </div>
      <div class="bg-surface rounded-3xl p-8">
        <span class="material-symbols-outlined text-3xl text-primary mb-3 block">schedule</span>
        <h2 class="font-headline font-bold text-lg text-on-surface mb-3">Waktu Operasi</h2>
        <p class="font-body text-sm text-secondary leading-relaxed">
          Isnin–Jumaat: 9:00 pagi – 6:00 petang<br />
          Sabtu: 9:00 pagi – 1:00 tengah hari<br />
          Ahad &amp; cuti umum: tutup (mesej WhatsApp tetap dibalas)
        </p>
      </div>
    </div>
  </section>

  <!-- Content block -->
  <section class="py-20 px-6 md:px-8 max-w-3xl mx-auto">
    <h2 class="font-headline text-3xl md:text-4xl font-extrabold tracking-tighter text-on-surface mb-6">Kenapa penduduk Putrajaya pesan kotak dari kami?</h2>
    <div class="font-body text-secondary leading-relaxed flex flex-col gap-5 text-base md:text-lg">
      <p>
        Di Putrajaya, pindah rumah bukan perkara luar biasa — ia sebahagian daripada hidup. Penjawat awam bertukar posting, keluarga berpindah antara kuarters dan apartmen di Presint 8, 9, 11, 14, 16 dan 18, dan jiran di Cyberjaya pula asyik bertukar unit sewa mengikut kontrak kerja. Masalahnya: <strong class="text-on-surface font-semibold">pilihan kotak di sekitar Putrajaya sangat terhad</strong>. Kebanyakan penjual beroperasi kecil-kecilan dari rumah dengan dua tiga saiz kotak sahaja — kalau stok habis, anda tunggu.
      </p>
      <p>
        Quinocycle berbeza kerana kami pembekal borong dengan gudang sebenar. Dari gudang kami di Balakong, kami simpan <strong class="text-on-surface font-semibold">18 jenis kotak</strong> — dari saiz XS untuk buku dan pinggan, hinggalah kotak L untuk selimut dan periuk besar. Kotak terpakai (RM0.90–RM5.00 sekotak) ialah gred sekali guna dari kilang: setiap satu disemak, kering dan bebas bau. Kotak baru pula dari RM1.10 hingga RM8.00. Tak pasti nak pilih yang mana? Baca <a href="/blog/beza-kotak-baru-kotak-terpakai" class="text-primary font-semibold hover:underline">perbezaan kotak baru dan kotak terpakai</a> atau lihat stok penuh di <a href="/used-carton-boxes" class="text-primary font-semibold hover:underline">halaman kotak terpakai</a> dan <a href="/shop" class="text-primary font-semibold hover:underline">kedai online kami</a>.
      </p>
      <p>
        Untuk pindahan biasa, rumah atau kuarters 3 bilik memerlukan sekitar 50–70 kotak — dapur sahaja boleh telan 15–20 kotak. Dengan penghantaran percuma untuk pesanan melebihi RM300, kebanyakan pelanggan Putrajaya terus pesan sekali gus tanpa perlu keluar bandar. Guna <a href="/blog/berapa-kotak-diperlukan-pindah-rumah" class="text-primary font-semibold hover:underline">panduan kiraan kotak ikut bilik</a> untuk anggaran, kemudian semak <a href="/blog/harga-kotak-pindah-rumah" class="text-primary font-semibold hover:underline">panduan harga kotak pindah rumah</a> supaya tahu anda dapat harga berpatutan.
      </p>
      <p>
        Cara pesan mudah sahaja: WhatsApp senarai saiz dan kuantiti ke 016-891 6381, kami balas dengan sebut harga, dan kotak dihantar ke pintu anda — atau singgah gudang Balakong (±25–30 minit memandu) jika mahu ambil sendiri. Lihat <a href="/kotak-pindah-rumah" class="text-primary font-semibold hover:underline">senarai harga penuh kotak pindah rumah</a> dan <a href="/blog/tips-pindah-rumah-packing-malaysia" class="text-primary font-semibold hover:underline">tips packing pindah rumah</a> sebelum mula mengemas.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-surface-container-low">
    <div class="max-w-3xl mx-auto px-6 md:px-8">
      <h2 class="font-headline text-3xl font-extrabold tracking-tighter text-on-surface mb-8">Soalan lazim — kotak pindah {CITY}</h2>
      <div class="flex flex-col divide-y divide-outline-variant/15">
        {faqs.map(f => (
          <details class="group py-5">
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-headline font-bold text-lg text-on-surface">
              {f.q}
              <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-45 flex-shrink-0" style="font-size:24px;">add</span>
            </summary>
            <p class="font-body text-sm text-secondary leading-relaxed mt-3">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Nearby areas -->
  <section class="py-16 px-6 md:px-8 max-w-7xl mx-auto">
    <h2 class="font-headline text-2xl font-extrabold tracking-tighter text-on-surface mb-6">Kawasan berdekatan</h2>
    <div class="flex flex-wrap gap-3">
      <a href="/kotak-pindah-rumah/kajang"          class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Kotak Pindah Kajang</a>
      <a href="/kotak-pindah-rumah/seri-kembangan"  class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Kotak Pindah Seri Kembangan</a>
      <a href="/kotak-pindah-rumah/puchong"         class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Kotak Pindah Puchong</a>
      <a href="/kotak-pindah-rumah"                 class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Semua Kawasan →</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-primary-container text-on-primary-container">
    <div class="max-w-4xl mx-auto px-6 md:px-8 text-center">
      <h2 class="font-headline text-4xl md:text-5xl font-extrabold tracking-tighter mb-6">Posting baru menanti. Kotak pun sama.</h2>
      <p class="font-body text-lg mb-10 opacity-90 max-w-xl mx-auto leading-relaxed">
        Hantar senarai kotak anda melalui WhatsApp — kami sebut harga, sahkan tarikh, dan hantar terus ke presint anda. Atau datang sendiri ke gudang kami di Taming Jaya, Balakong.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="bg-[#25D366] text-white px-10 py-4 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:bg-[#1ebd5a] transition-colors">
          WhatsApp 016-891 6381
        </a>
        <a href="https://www.google.com/maps/search/?api=1&query=Quinocycle+No.13+Jalan+Taming+P%2F1+Taming+Jaya+43300+Balakong+Selangor" target="_blank" rel="noopener noreferrer" class="bg-on-surface text-surface px-10 py-4 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-colors">
          Gudang Balakong di Google Maps
        </a>
      </div>
    </div>
  </section>
</Layout>
