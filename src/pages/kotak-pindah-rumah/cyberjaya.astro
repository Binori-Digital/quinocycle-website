---
import Layout from '../../layouts/Layout.astro';

const CITY = 'Cyberjaya';
const WA_NUMBER = '60168916381';
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(`Hi Quinocycle! Saya nak beli kotak pindah rumah di ${CITY}.`)}`;

const faqs = [
  {
    q: 'Ada kilang kotak di Cyberjaya?',
    a: 'Jawapan jujur: tiada. Cyberjaya dibangunkan sebagai hab teknologi, bukan kawasan perindustrian kotak — jadi tiada kilang atau gudang kotak borong di dalam bandar ini. Quinocycle ialah gudang pemborong di Balakong (±25–30 minit melalui MEX atau ELITE) yang menawarkan harga aras kilang, dihantar terus ke pintu anda di Cyberjaya. Lihat halaman <a href="/kilang-kotak" class="text-primary font-semibold hover:underline">kilang kotak</a> kami untuk memahami bagaimana harga borong kami berfungsi.',
  },
  {
    q: 'Berapa cepat kotak sampai ke Cyberjaya?',
    a: 'Gudang kami di Taming Jaya, Balakong hanya ±25–30 minit dari Cyberjaya melalui Lebuhraya Maju (MEX) atau ELITE. Pesanan yang disahkan melalui WhatsApp pada waktu pagi biasanya boleh dihantar pada hari yang sama; selewat-lewatnya keesokan hari bekerja. Penghantaran percuma untuk pesanan melebihi RM300.',
  },
  {
    q: 'Saya pelajar MMU nak keluar hostel — kena beli banyak ke?',
    a: 'Tidak perlu. Kebanyakan pelajar MMU cuma perlukan 5–15 kotak, dan pesanan kecil begini boleh diuruskan terus melalui WhatsApp 016-891 6381 untuk sebut harga (minimum borong RM1,000 hanya untuk pesanan pukal syarikat). Kotak terpakai dari RM0.90 sekotak adalah pilihan paling jimat untuk bajet pelajar — yang termurah dalam stok semasa sekitar RM1.70, dan stok berubah dari semasa ke semasa.',
  },
  {
    q: 'Kotak apa sesuai untuk pindah dari kondo high-rise di Cyberjaya?',
    a: 'Untuk unit kondo dengan lif dan koridor, elakkan kotak yang terlalu besar sehingga sukar diangkat seorang diri. Campuran saiz S (buku, barang dapur berat) dan saiz M (pakaian, barangan bilik) paling praktikal. Untuk peralatan besar seperti monitor atau kerusi gaming, kami ada kotak kargo XXL dari RM28 hingga RM38. Semua saiz boleh dilihat di kedai online kami, shop.quinocycle.com.',
  },
];

const storeSchema = {
  "@context": "https://schema.org",
  "@type": "Store",
  "name": `Quinocycle — Kotak Pindah Rumah ${CITY}`,
  "description": `Pembekal kotak pindah rumah untuk ${CITY} — kondo high-rise, hostel MMU dan kawasan kediaman sekitar tasik. Kotak terpakai dari RM0.90, kotak baru dari RM1.10, penghantaran hari sama atau esok dari gudang Balakong melalui MEX/ELITE.`,
  "url": "https://www.quinocycle.com.my/kotak-pindah-rumah/cyberjaya/",
  "telephone": "+60168916381",
  "priceRange": "RM0.90 - RM9.00 sekotak",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "No.13, Jalan Taming P/1, Taming Jaya",
    "addressLocality": "Balakong",
    "addressRegion": "Selangor",
    "postalCode": "43300",
    "addressCountry": "MY"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 3.0579, "longitude": 101.7468 },
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "17:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "09:00", "closes": "13:00" }
  ],
  "areaServed": ["Cyberjaya","Setia Eco Glades","Symphony Hills","Mutiara Ville","Serin Residency","Lakefront Residence","MMU Cyberjaya"]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://www.quinocycle.com.my/" },
    { "@type": "ListItem", "position": 2, "name": "Kotak Pindah Rumah", "item": "https://www.quinocycle.com.my/kotak-pindah-rumah/" },
    { "@type": "ListItem", "position": 3, "name": CITY, "item": "https://www.quinocycle.com.my/kotak-pindah-rumah/cyberjaya/" }
  ]
};
---

<Layout
  lang="ms"
  title={`Kotak Pindah Rumah ${CITY} — Harga Kilang Terus Ke Bandar Teknologi, dari RM0.90 | Quinocycle`}
  description={`Pindah kondo atau keluar hostel MMU di ${CITY}? Kotak terpakai dari RM0.90, baru dari RM1.10 — dihantar 25–30 minit dari Balakong via MEX. WhatsApp 016-891 6381.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(storeSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="pt-16 pb-12 px-6 md:px-8 max-w-7xl mx-auto">
    <nav class="font-body text-xs text-secondary mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary transition-colors">Utama</a>
      <span class="mx-2">/</span>
      <a href="/kotak-pindah-rumah" class="hover:text-primary transition-colors">Kotak Pindah Rumah</a>
      <span class="mx-2">/</span>
      <span class="text-on-surface font-semibold">{CITY}</span>
    </nav>
    <span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4 block">Kawasan Penghantaran Kami</span>
    <h1 class="font-headline text-4xl md:text-6xl font-extrabold tracking-tighter text-on-surface leading-[0.95] mb-6 max-w-4xl">
      Kotak pindah rumah {CITY} <br /><span class="text-primary italic">— harga kilang, sampai ikut MEX.</span>
    </h1>
    <p class="font-body text-lg md:text-xl text-secondary max-w-2xl leading-relaxed mb-8">
      Bandar paling berteknologi di Malaysia tak ada satu pun pembekal kotak borong — jadi biar kami yang datang. Dari gudang Balakong, kotak sampai ke <strong class="text-on-surface font-semibold">kondo sekitar tasik, hostel MMU dan pejabat syarikat teknologi Cyberjaya</strong> dalam ±25–30 minit melalui MEX atau ELITE. Kotak terpakai dari <strong class="text-on-surface font-semibold">RM0.90</strong>, kotak baru dari <strong class="text-on-surface font-semibold">RM1.10</strong>, penghantaran percuma untuk pesanan RM300 ke atas.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-[#25D366] text-white px-8 py-3.5 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:bg-[#1ebd5a] transition-colors">
        WhatsApp Sekarang
      </a>
      <a href="/kotak-pindah-rumah#senarai-harga" class="bg-primary-container text-on-primary-container px-8 py-3.5 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-all">
        Senarai Harga Penuh
      </a>
    </div>
  </section>

  <!-- Local info -->
  <section class="py-16 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-6 md:px-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-surface rounded-3xl p-8">
        <span class="material-symbols-outlined text-3xl text-primary mb-3 block">route</span>
        <h2 class="font-headline font-bold text-lg text-on-surface mb-3">Laluan Terus MEX / ELITE</h2>
        <p class="font-body text-sm text-secondary leading-relaxed">
          Balakong ke Cyberjaya cuma ±25–30 minit melalui Lebuhraya Maju atau ELITE. Sahkan pesanan sebelum tengah hari dan lori kami boleh singgah ke lobi kondo anda pada hari yang sama — kalau tidak, keesokan hari bekerja.
        </p>
      </div>
      <div class="bg-surface rounded-3xl p-8">
        <span class="material-symbols-outlined text-3xl text-primary mb-3 block">apartment</span>
        <h2 class="font-headline font-bold text-lg text-on-surface mb-3">Biasa Dengan Kondo High-Rise</h2>
        <p class="font-body text-sm text-secondary leading-relaxed">
          Ramai pelanggan Cyberjaya kami tinggal di unit sewa bertingkat tinggi. Maklumkan nama kediaman dan nombor unit semasa order melalui WhatsApp — kami selaraskan masa penghantaran supaya senang urusan di lobi dan lif barang.
        </p>
      </div>
      <div class="bg-surface rounded-3xl p-8">
        <span class="material-symbols-outlined text-3xl text-primary mb-3 block">schedule</span>
        <h2 class="font-headline font-bold text-lg text-on-surface mb-3">Waktu Operasi Gudang</h2>
        <p class="font-body text-sm text-secondary leading-relaxed">
          Isnin–Jumaat: 9:00 pagi – 5:00 petang<br />
          Sabtu: 9:00 pagi – 1:00 tengah hari<br />
          Nak ambil sendiri? Gudang kami di No.13, Jalan Taming P/1, Taming Jaya, 43300 Balakong — WhatsApp dulu supaya pesanan siap disusun.
        </p>
      </div>
    </div>
  </section>

  <!-- Content block -->
  <section class="py-20 px-6 md:px-8 max-w-3xl mx-auto">
    <h2 class="font-headline text-3xl md:text-4xl font-extrabold tracking-tighter text-on-surface mb-6">Kenapa penduduk Cyberjaya pesan kotak dari Balakong?</h2>
    <div class="font-body text-secondary leading-relaxed flex flex-col gap-5 text-base md:text-lg">
      <p>
        Cyberjaya ialah bandar yang penduduknya sentiasa bergerak. Staf syarikat teknologi dan pusat data bertukar projek dan berpindah mengikut kontrak. Pelajar MMU masuk dan keluar hostel setiap semester. Dan kerana sebahagian besar kediaman di sini ialah <strong class="text-on-surface font-semibold">kondo high-rise yang disewa golongan profesional muda</strong>, kadar pindah-masuk dan pindah-keluar jauh lebih tinggi berbanding taman perumahan biasa. Ironinya, bandar pintar ini langsung tiada pembekal kotak sendiri — pilihan yang ada cuma kedai runcit dengan harga tinggi, atau marketplace online yang ambil masa berhari-hari.
      </p>
      <p>
        Di sinilah kedudukan kami menjadi kelebihan anda. Gudang Quinocycle di Taming Jaya, Balakong terletak <strong class="text-on-surface font-semibold">±25–30 minit dari Cyberjaya melalui MEX atau ELITE</strong> — cukup dekat untuk penghantaran hari sama, cukup jauh untuk kekalkan kos gudang yang rendah. Hasilnya, anda bayar harga pemborong: <a href="/kotak-terpakai" class="text-primary font-semibold hover:underline">kotak terpakai</a> antara RM0.90 hingga RM6.00 sekotak (pilihan termurah dalam stok semasa sekitar RM1.70 — stok sentiasa berputar), kotak baru antara RM1.10 hingga RM9.00, dan kotak kargo XXL RM28–RM38 untuk barangan besar. Katalog penuh ada di kedai online kami, shop.quinocycle.com.
      </p>
      <p>
        Setiap kumpulan penduduk Cyberjaya ada keperluan berbeza. Pelajar MMU yang mengosongkan bilik hostel selalunya cukup dengan 5–15 kotak terpakai — mesej kami di WhatsApp untuk sebut harga kuantiti kecil. Pasangan muda yang berpindah antara kediaman sekitar tasik, atau ulang-alik ke Putrajaya sebagai bandar kembarnya, biasanya perlukan 40–60 kotak campuran saiz. Syarikat teknologi yang menempatkan semula pejabat atau peralatan pula boleh terus masuk ke pesanan borong (minimum RM1,000) dengan bekalan konsisten dari gudang.
      </p>
      <p>
        Satu lagi soalan yang kerap kami terima: "kenapa tak beli terus dari kilang?" Jawapannya kami terangkan penuh di halaman <a href="/kilang-kotak" class="text-primary font-semibold hover:underline">kilang kotak</a> — ringkasnya, kilang menjual dalam kuantiti ribuan unit kepada pemborong seperti kami, dan tugas kami ialah memecahkan kuantiti itu kepada harga aras kilang yang boleh dibeli sesiapa sahaja. Order sebelum tengah hari, dan kotak anda bergerak keluar dari Balakong pada hari yang sama.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-surface-container-low">
    <div class="max-w-3xl mx-auto px-6 md:px-8">
      <h2 class="font-headline text-3xl font-extrabold tracking-tighter text-on-surface mb-8">Soalan lazim — kotak pindah {CITY}</h2>
      <div class="flex flex-col divide-y divide-outline-variant/15">
        {faqs.map(f => (
          <details class="group py-5">
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-headline font-bold text-lg text-on-surface">
              {f.q}
              <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-45 flex-shrink-0" style="font-size:24px;">add</span>
            </summary>
            <p class="font-body text-sm text-secondary leading-relaxed mt-3" set:html={f.a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Nearby areas -->
  <section class="py-16 px-6 md:px-8 max-w-7xl mx-auto">
    <h2 class="font-headline text-2xl font-extrabold tracking-tighter text-on-surface mb-6">Kawasan berdekatan</h2>
    <div class="flex flex-wrap gap-3">
      <a href="/kotak-pindah-rumah/putrajaya" class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Kotak Pindah Putrajaya</a>
      <a href="/kotak-pindah-rumah/bangi"     class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Kotak Pindah Bangi</a>
      <a href="/kotak-pindah-rumah/kajang"    class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Kotak Pindah Kajang</a>
      <a href="/kotak-pindah-rumah"           class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Semua Kawasan →</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-primary-container text-on-primary-container">
    <div class="max-w-4xl mx-auto px-6 md:px-8 text-center">
      <h2 class="font-headline text-4xl md:text-5xl font-extrabold tracking-tighter mb-6">Kotak untuk Cyberjaya, dihantar sepantas bandar ini bergerak.</h2>
      <p class="font-body text-lg mb-10 opacity-90 max-w-xl mx-auto leading-relaxed">
        Sama ada anda mengosongkan hostel MMU, pindah kondo sekitar tasik atau menguruskan relokasi pejabat — hantar senarai saiz dan kuantiti ke WhatsApp, dan kami balas dengan sebut harga serta slot penghantaran ke Cyberjaya.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="bg-[#25D366] text-white px-10 py-4 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:bg-[#1ebd5a] transition-colors">
          WhatsApp 016-891 6381
        </a>
        <a href="https://www.google.com/maps/search/?api=1&query=Quinocycle+No.13+Jalan+Taming+P%2F1+Taming+Jaya+43300+Balakong+Selangor" target="_blank" rel="noopener noreferrer" class="bg-on-surface text-surface px-10 py-4 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-colors">
          Lokasi Gudang (Balakong)
        </a>
      </div>
    </div>
  </section>
</Layout>
