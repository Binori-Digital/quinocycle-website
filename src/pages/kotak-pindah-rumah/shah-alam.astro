---
import Layout from '../../layouts/Layout.astro';

const CITY = 'Shah Alam';
const WA_NUMBER = '60168916381';
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(`Hi Quinocycle! Saya nak beli kotak pindah rumah di ${CITY}.`)}`;

const faqs = [
  {
    q: 'Ada kilang kotak di Shah Alam?',
    a: 'Soal jujur, jawapan jujur: Quinocycle bukan kilang, dan kami tidak tahu ada kilang kotak yang melayan pembeli runcit di Shah Alam. Kami ialah gudang pembekal borong di Taming Jaya, Balakong — kotak dibeli terus pada skala besar, jadi harganya setara harga kilang: kotak terpakai dari RM0.90, kotak baru dari RM1.10 sekotak. Untuk Shah Alam, anda tak perlu jejak kilang pun — kami hantar ke pintu rumah anda dalam 1 hari bekerja, percuma untuk pesanan melebihi RM300.',
    href: '/kilang-kotak',
    linkText: 'Lihat harga kilang dari gudang pembekal →',
  },
  {
    q: 'Berapa lama penghantaran kotak ke Shah Alam?',
    a: 'Dalam 1 hari bekerja. Gudang kami di Balakong hanya ±35–40 minit memandu dari Shah Alam, jadi pesanan yang disahkan melalui WhatsApp biasanya sampai keesokan hari bekerja — ke Seksyen 7, Seksyen 13, U8, U10, sekitar i-City dan mana-mana seksyen lain. Penghantaran percuma untuk pesanan melebihi RM300 (KL & Selangor).',
  },
  {
    q: 'Saya pelajar UITM nak pindah rumah sewa — boleh order kuantiti kecil?',
    a: 'Boleh dibincang. Kuantiti minimum kami ialah 50–200 unit sesaiz untuk harga borong penuh, tapi untuk kuantiti lebih kecil hantar sahaja senarai anda ke WhatsApp 016-891 6381 dan kami beri sebut harga. Tip untuk pelajar: kotak terpakai dari RM0.90 paling jimat untuk bajet pelajar, dan kalau satu rumah sewa gabungkan pesanan sampai melebihi RM300, penghantaran ke Seksyen 7 terus percuma.',
  },
  {
    q: 'Kami operasi kilang di Seksyen 15 — boleh bekal kotak packing secara tetap?',
    a: 'Ya, itu memang kerja utama kami. Quinocycle membekalkan kotak kardus baru dan terpakai kepada kilang, gudang dan penjual online di seluruh Lembah Klang, termasuk kawasan perindustrian Seksyen 15 dan Seksyen 23 Shah Alam. Pesanan borong penuh bermula RM1,000, dengan penghantaran berjadual ikut keperluan operasi anda. WhatsApp spesifikasi saiz dan kuantiti bulanan untuk sebut harga borong.',
  },
];

const storeSchema = {
  "@context": "https://schema.org",
  "@type": "Store",
  "name": `Quinocycle — Kotak Pindah Rumah ${CITY}`,
  "description": `Pembekal kotak pindah rumah untuk ${CITY} — Seksyen 7, Seksyen 13, U8, U10, i-City hingga kawasan perindustrian Seksyen 15 & 23. Kotak kardus baru dan terpakai harga borong dari RM0.90 sekotak, dihantar dalam 1 hari bekerja dari gudang Balakong.`,
  "url": "https://www.quinocycle.com.my/kotak-pindah-rumah/shah-alam/",
  "telephone": "+60168916381",
  "priceRange": "RM0.90 - RM8.00 sekotak",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "No.13, Jalan Taming P/1, Taming Jaya",
    "addressLocality": "Balakong",
    "addressRegion": "Selangor",
    "postalCode": "43300",
    "addressCountry": "MY"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 3.0579, "longitude": 101.7468 },
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "17:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "09:00", "closes": "13:00" }
  ],
  "areaServed": ["Shah Alam","Seksyen 7 Shah Alam","Seksyen 13 Shah Alam","Seksyen U8 Shah Alam","Seksyen U10 Shah Alam","i-City","Seksyen 15 Shah Alam","Seksyen 23 Shah Alam"]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://www.quinocycle.com.my/" },
    { "@type": "ListItem", "position": 2, "name": "Kotak Pindah Rumah", "item": "https://www.quinocycle.com.my/kotak-pindah-rumah/" },
    { "@type": "ListItem", "position": 3, "name": CITY, "item": "https://www.quinocycle.com.my/kotak-pindah-rumah/shah-alam/" }
  ]
};
---

<Layout
  lang="ms"
  title={`Kotak Pindah Rumah ${CITY} — Harga Kilang Sampai ke Seksyen Anda, dari RM0.90 | Quinocycle`}
  description={`Tak perlu cari kilang kotak di ${CITY}. Kami hantar kotak pindah harga borong ke Seksyen 7, 13, U8, U10 & i-City dalam 1 hari bekerja — dari RM0.90, percuma untuk order RM300+. WhatsApp 016-891 6381.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(storeSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="pt-16 pb-12 px-6 md:px-8 max-w-7xl mx-auto">
    <nav class="font-body text-xs text-secondary mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary transition-colors">Utama</a>
      <span class="mx-2">/</span>
      <a href="/kotak-pindah-rumah" class="hover:text-primary transition-colors">Kotak Pindah Rumah</a>
      <span class="mx-2">/</span>
      <span class="text-on-surface font-semibold">{CITY}</span>
    </nav>
    <span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4 block">Kawasan Penghantaran Kami</span>
    <h1 class="font-headline text-4xl md:text-6xl font-extrabold tracking-tighter text-on-surface leading-[0.95] mb-6 max-w-4xl">
      Kotak pindah rumah {CITY} <br /><span class="text-primary italic">— harga kilang, tanpa cari kilang.</span>
    </h1>
    <p class="font-body text-lg md:text-xl text-secondary max-w-2xl leading-relaxed mb-8">
      Ramai yang google "kilang kotak Shah Alam" sebelum pindah — padahal yang anda perlukan bukan kilangnya, tapi harganya. Quinocycle ialah gudang pembekal borong di Balakong yang menghantar terus ke <strong class="text-on-surface font-semibold">Seksyen 7, Seksyen 13, U8, U10 dan sekitar i-City</strong> dalam 1 hari bekerja: kotak terpakai dari <strong class="text-on-surface font-semibold">RM0.90</strong>, kotak baru dari <strong class="text-on-surface font-semibold">RM1.10</strong> sekotak — percuma untuk pesanan melebihi RM300.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-[#25D366] text-white px-8 py-3.5 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:bg-[#1ebd5a] transition-colors">
        WhatsApp Sekarang
      </a>
      <a href="/kotak-pindah-rumah#senarai-harga" class="bg-primary-container text-on-primary-container px-8 py-3.5 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-all">
        Senarai Harga Penuh
      </a>
    </div>
  </section>

  <!-- Local info -->
  <section class="py-16 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-6 md:px-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-surface rounded-3xl p-8">
        <span class="material-symbols-outlined text-3xl text-primary mb-3 block">local_shipping</span>
        <h2 class="font-headline font-bold text-lg text-on-surface mb-3">Sampai Dalam 1 Hari Bekerja</h2>
        <p class="font-body text-sm text-secondary leading-relaxed">
          Gudang kami di Balakong ±35–40 minit dari Shah Alam. Sahkan pesanan melalui WhatsApp hari ini, dan lori kami sampai ke Seksyen 7, 13, U8, U10 atau i-City pada hari bekerja berikutnya — percuma untuk pesanan melebihi RM300.
        </p>
      </div>
      <div class="bg-surface rounded-3xl p-8">
        <span class="material-symbols-outlined text-3xl text-primary mb-3 block">factory</span>
        <h2 class="font-headline font-bold text-lg text-on-surface mb-3">Bekalan Untuk Kilang &amp; Bisnes</h2>
        <p class="font-body text-sm text-secondary leading-relaxed">
          Kilang dan gudang sekitar Seksyen 15 dan Seksyen 23 boleh dapatkan bekalan kotak packing secara tetap pada harga borong — pesanan borong penuh dari RM1,000, jadual penghantaran ikut keperluan operasi anda.
        </p>
      </div>
      <div class="bg-surface rounded-3xl p-8">
        <span class="material-symbols-outlined text-3xl text-primary mb-3 block">schedule</span>
        <h2 class="font-headline font-bold text-lg text-on-surface mb-3">Waktu &amp; Pickup</h2>
        <p class="font-body text-sm text-secondary leading-relaxed">
          Isnin–Jumaat: 9:00 pagi – 5:00 petang<br />
          Sabtu: 9:00 pagi – 1:00 tengah hari<br />
          Ahad: tutup. Nak jimat kos hantar? Ambil sendiri di gudang Balakong — WhatsApp dulu supaya pesanan siap dibungkus.
        </p>
      </div>
    </div>
  </section>

  <!-- Content block -->
  <section class="py-20 px-6 md:px-8 max-w-3xl mx-auto">
    <h2 class="font-headline text-3xl md:text-4xl font-extrabold tracking-tighter text-on-surface mb-6">Kenapa penduduk Shah Alam order kotak dari kami?</h2>
    <div class="font-body text-secondary leading-relaxed flex flex-col gap-5 text-base md:text-lg">
      <p>
        Shah Alam bandar yang besar — dari Seksyen 7 dan Seksyen 13 di tengah bandar hinggalah U8 dan U10 di sebelah barat. Tapi besar mana pun, satu benda susah dijumpai: <strong class="text-on-surface font-semibold">pembekal kotak pada harga borong</strong>. Yang ada cuma kedai hardware dan kedai alat tulis yang jual kotak sekeping RM8 hingga RM12. Sebab itulah ramai penduduk Shah Alam akhirnya menaip "kilang kotak Shah Alam" di Google — dan sebab itulah halaman ini wujud. Kami bukan kilang; kami <a href="/kilang-kotak" class="text-primary font-semibold hover:underline">gudang pembekal yang jual pada harga kilang</a>, dan kami hantar terus ke seksyen anda dalam 1 hari bekerja.
      </p>
      <p>
        Pilihan paling jimat ialah <a href="/kotak-terpakai" class="text-primary font-semibold hover:underline">kotak terpakai</a> dari RM0.90 sekotak — gred sekali guna dari kilang, setiap unit disemak, kering dan bebas bau, jadi selamat untuk pakaian, buku dan barang dapur. Kotak baru pula bermula RM1.10 sekotak dan boleh ditempah melalui <a href="/shop" class="text-primary font-semibold hover:underline">kedai online kami</a>. Kalau masih timbang-timbang, <a href="/blog/beza-kotak-baru-kotak-terpakai" class="text-primary font-semibold hover:underline">perbandingan kotak baru vs terpakai</a> kami huraikan bila berbaloi bayar lebih — dan bila tak perlu langsung.
      </p>
      <p>
        Untuk pelajar UITM yang bertukar semester atau berpindah rumah sewa sekitar Seksyen 7 dan i-City, kotak terpakai memang penyelamat bajet. Satu lagi helah yang pelanggan pelajar kami selalu guna: gabungkan pesanan satu rumah sewa supaya melebihi RM300 — penghantaran terus jadi percuma. Tak pasti berapa banyak kotak cukup? Guna <a href="/blog/berapa-kotak-diperlukan-pindah-rumah" class="text-primary font-semibold hover:underline">panduan kiraan kotak</a> kami; anggaran kasar untuk rumah 3 bilik ialah 50–70 kotak campuran saiz S dan M.
      </p>
      <p>
        Bagi kilang, gudang dan penjual online di kawasan perindustrian Seksyen 15 dan Seksyen 23, kami tawarkan bekalan berterusan — pesanan borong penuh bermula RM1,000, dengan kuantiti minimum 50–200 unit sesaiz. Sebelum WhatsApp, semak dulu <a href="/kotak-pindah-rumah" class="text-primary font-semibold hover:underline">senarai harga penuh kotak pindah rumah</a> dan <a href="/blog/harga-kotak-pindah-rumah" class="text-primary font-semibold hover:underline">panduan harga kotak pindah</a> supaya anda tahu tepat apa yang anda bayar — tiada harga tersembunyi, tiada orang tengah.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-surface-container-low">
    <div class="max-w-3xl mx-auto px-6 md:px-8">
      <h2 class="font-headline text-3xl font-extrabold tracking-tighter text-on-surface mb-8">Soalan lazim — kotak pindah {CITY}</h2>
      <div class="flex flex-col divide-y divide-outline-variant/15">
        {faqs.map(f => (
          <details class="group py-5">
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-headline font-bold text-lg text-on-surface">
              {f.q}
              <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-45 flex-shrink-0" style="font-size:24px;">add</span>
            </summary>
            <p class="font-body text-sm text-secondary leading-relaxed mt-3">
              {f.a}
              {f.href && <> <a href={f.href} class="text-primary font-semibold hover:underline">{f.linkText}</a></>}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Nearby areas -->
  <section class="py-16 px-6 md:px-8 max-w-7xl mx-auto">
    <h2 class="font-headline text-2xl font-extrabold tracking-tighter text-on-surface mb-6">Kawasan berdekatan</h2>
    <div class="flex flex-wrap gap-3">
      <a href="/kotak-pindah-rumah/klang"        class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Kotak Pindah Klang</a>
      <a href="/kotak-pindah-rumah/puchong"      class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Kotak Pindah Puchong</a>
      <a href="/kotak-pindah-rumah/kuala-lumpur" class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Kotak Pindah Kuala Lumpur</a>
      <a href="/kotak-pindah-rumah"              class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Semua Kawasan →</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-primary-container text-on-primary-container">
    <div class="max-w-4xl mx-auto px-6 md:px-8 text-center">
      <h2 class="font-headline text-4xl md:text-5xl font-extrabold tracking-tighter mb-6">Kotak siap di depan pintu, esok hari bekerja.</h2>
      <p class="font-body text-lg mb-10 opacity-90 max-w-xl mx-auto leading-relaxed">
        Hantar senarai saiz dan kuantiti anda ke WhatsApp — kami balas dengan sebut harga borong dan aturkan penghantaran ke mana-mana seksyen di Shah Alam, atau sediakan pesanan untuk pickup di gudang Balakong.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="bg-[#25D366] text-white px-10 py-4 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:bg-[#1ebd5a] transition-colors">
          WhatsApp 016-891 6381
        </a>
        <a href="https://www.google.com/maps/search/?api=1&query=Quinocycle+No.13+Jalan+Taming+P%2F1+Taming+Jaya+43300+Balakong+Selangor" target="_blank" rel="noopener noreferrer" class="bg-on-surface text-surface px-10 py-4 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-colors">
          Lokasi Gudang (Balakong)
        </a>
      </div>
    </div>
  </section>
</Layout>
