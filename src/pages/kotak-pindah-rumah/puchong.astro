---
import Layout from '../../layouts/Layout.astro';

const CITY = 'Puchong';
const WA_NUMBER = '60168916381';
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(`Hi Quinocycle! Saya nak beli kotak pindah rumah di ${CITY}.`)}`;

const faqs = [
  {
    q: 'Ada kedai kotak pindah rumah di Puchong?',
    a: 'Setakat ini tiada gudang pembekal kotak borong di dalam Puchong sendiri — dan itulah sebabnya kami hantar terus. Gudang Quinocycle terletak di Taming Jaya, Balakong (±25–30 minit memandu dari Puchong). WhatsApp pesanan anda waktu pagi, dan kami aturkan penghantaran ke Bandar Puteri, Puchong Jaya, Bandar Kinrara atau Puchong Perdana pada hari yang sama atau keesokan harinya.',
  },
  {
    q: 'Berapa kos penghantaran kotak ke Puchong?',
    a: 'Percuma untuk pesanan melebihi RM300 — Puchong termasuk dalam kawasan penghantaran percuma KL & Selangor kami. Untuk kuantiti lebih kecil, hantar senarai saiz dan kuantiti melalui WhatsApp 016-891 6381 dan kami beri sebut harga penghantaran terus.',
  },
  {
    q: 'Berapa banyak kotak saya perlukan untuk rumah di Puchong?',
    a: 'Anggaran biasa: rumah atau kondo 3 bilik perlukan 50–70 kotak. Ikut bilik pula — bilik tidur 10–15, dapur 15–20, ruang tamu 8–12, bilik air 3–5 kotak. Campurkan saiz S untuk barang berat seperti buku, dan saiz M/L untuk pakaian serta barangan dapur.',
  },
  {
    q: 'Boleh tak saya ambil sendiri kotak kalau tinggal di Puchong?',
    a: 'Boleh. Gudang kami di No.13, Jalan Taming P/1, Taming Jaya, 43300 Balakong, Selangor — ±25–30 minit memandu dari kawasan IOI Mall Puchong. Buka Isnin–Jumaat 9:00 pagi–5:00 petang dan Sabtu 9:00 pagi–1:00 tengah hari. WhatsApp dulu supaya kotak siap dibungkus bila anda tiba.',
  },
];

const storeSchema = {
  "@context": "https://schema.org",
  "@type": "Store",
  "name": `Quinocycle — Kotak Pindah Rumah ${CITY}`,
  "description": `Pembekal kotak pindah rumah untuk kawasan ${CITY} — Bandar Puteri, Puchong Jaya, Bandar Kinrara & Puchong Perdana. Kotak kardus baru dan terpakai harga borong dari RM0.90 sekotak, penghantaran hari sama atau esok dari gudang Balakong.`,
  "url": "https://www.quinocycle.com.my/kotak-pindah-rumah/puchong/",
  "telephone": "+60168916381",
  "priceRange": "RM0.90 - RM8.00 sekotak",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "No.13, Jalan Taming P/1, Taming Jaya",
    "addressLocality": "Balakong",
    "addressRegion": "Selangor",
    "postalCode": "43300",
    "addressCountry": "MY"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 3.0579, "longitude": 101.7468 },
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "17:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "09:00", "closes": "13:00" }
  ],
  "areaServed": ["Puchong","Bandar Puteri Puchong","Puchong Jaya","Bandar Kinrara","Puchong Perdana","Puchong Utama"]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://www.quinocycle.com.my/" },
    { "@type": "ListItem", "position": 2, "name": "Kotak Pindah Rumah", "item": "https://www.quinocycle.com.my/kotak-pindah-rumah/" },
    { "@type": "ListItem", "position": 3, "name": CITY, "item": "https://www.quinocycle.com.my/kotak-pindah-rumah/puchong/" }
  ]
};
---

<Layout
  lang="ms"
  title={`Kotak Pindah Rumah ${CITY} — Order Pagi Sampai Hari Sama, dari RM0.90 | Quinocycle`}
  description={`Perlu kotak pindah rumah di ${CITY}? Kami hantar ke Bandar Puteri, Puchong Jaya & Kinrara — kotak dari RM0.90, percuma untuk order RM300+. WhatsApp 016-891 6381.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(storeSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="pt-16 pb-12 px-6 md:px-8 max-w-7xl mx-auto">
    <nav class="font-body text-xs text-secondary mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary transition-colors">Utama</a>
      <span class="mx-2">/</span>
      <a href="/kotak-pindah-rumah" class="hover:text-primary transition-colors">Kotak Pindah Rumah</a>
      <span class="mx-2">/</span>
      <span class="text-on-surface font-semibold">{CITY}</span>
    </nav>
    <span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4 block">Kawasan Penghantaran Kami</span>
    <h1 class="font-headline text-4xl md:text-6xl font-extrabold tracking-tighter text-on-surface leading-[0.95] mb-6 max-w-4xl">
      Kotak pindah rumah {CITY} <br /><span class="text-primary italic">— order pagi, terima hari sama.</span>
    </h1>
    <p class="font-body text-lg md:text-xl text-secondary max-w-2xl leading-relaxed mb-8">
      Tak ada gudang kotak borong di Puchong? Tak jadi masalah. Quinocycle menghantar terus dari gudang pembekal kami di Balakong ke <strong class="text-on-surface font-semibold">Bandar Puteri, Puchong Jaya, Bandar Kinrara dan Puchong Perdana</strong> — kotak terpakai dari <strong class="text-on-surface font-semibold">RM0.90</strong>, kotak baru dari <strong class="text-on-surface font-semibold">RM1.10</strong> sekotak, penghantaran percuma untuk pesanan melebihi RM300.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-[#25D366] text-white px-8 py-3.5 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:bg-[#1ebd5a] transition-colors">
        WhatsApp Sekarang
      </a>
      <a href="/kotak-pindah-rumah#senarai-harga" class="bg-primary-container text-on-primary-container px-8 py-3.5 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-all">
        Senarai Harga Penuh
      </a>
    </div>
  </section>

  <!-- Local info -->
  <section class="py-16 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-6 md:px-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-surface rounded-3xl p-8">
        <span class="material-symbols-outlined text-3xl text-primary mb-3 block">local_shipping</span>
        <h2 class="font-headline font-bold text-lg text-on-surface mb-3">Hantar Terus Ke Puchong</h2>
        <p class="font-body text-sm text-secondary leading-relaxed">
          Bandar Puteri, Puchong Jaya, Bandar Kinrara, Puchong Perdana dan sekitar IOI Mall — WhatsApp pesanan anda waktu pagi, kami hantar hari yang sama atau keesokan hari. Percuma untuk pesanan melebihi RM300 (KL &amp; Selangor).
        </p>
      </div>
      <div class="bg-surface rounded-3xl p-8">
        <span class="material-symbols-outlined text-3xl text-primary mb-3 block">storefront</span>
        <h2 class="font-headline font-bold text-lg text-on-surface mb-3">Atau Ambil Sendiri di Balakong</h2>
        <p class="font-body text-sm text-secondary leading-relaxed">
          Nak jimat penuh? Gudang kami di No.13, Jalan Taming P/1, Taming Jaya, 43300 Balakong — ±25–30 minit memandu dari Puchong. WhatsApp dulu, dan pesanan anda siap menunggu bila anda tiba.
        </p>
      </div>
      <div class="bg-surface rounded-3xl p-8">
        <span class="material-symbols-outlined text-3xl text-primary mb-3 block">schedule</span>
        <h2 class="font-headline font-bold text-lg text-on-surface mb-3">Waktu Urusan</h2>
        <p class="font-body text-sm text-secondary leading-relaxed">
          Isnin–Jumaat: 9:00 pagi – 5:00 petang<br />
          Sabtu: 9:00 pagi – 1:00 tengah hari<br />
          Ahad &amp; cuti umum: tutup — tapi mesej WhatsApp tetap kami balas
        </p>
      </div>
    </div>
  </section>

  <!-- Content block -->
  <section class="py-20 px-6 md:px-8 max-w-3xl mx-auto">
    <h2 class="font-headline text-3xl md:text-4xl font-extrabold tracking-tighter text-on-surface mb-6">Kenapa penduduk Puchong order kotak dari kami?</h2>
    <div class="font-body text-secondary leading-relaxed flex flex-col gap-5 text-base md:text-lg">
      <p>
        Puchong ada hampir segalanya — mall, kedai hardware, kedai serbaneka di setiap simpang. Tapi satu benda yang tiada: <strong class="text-on-surface font-semibold">gudang pembekal kotak borong</strong>. Jadi bila tiba masa nak pindah rumah, kebanyakan penduduk Bandar Puteri, Puchong Jaya dan Bandar Kinrara terpaksa beli kotak sekeping-sekeping di kedai hardware pada harga RM8 hingga RM12 sekotak, atau tempah online dan tunggu berhari-hari. Sedangkan pembekal sebenar cuma ±25–30 minit memandu dari kawasan IOI Mall.
      </p>
      <p>
        Quinocycle ialah pembekal kotak kardus yang beroperasi dari Taming Jaya, Balakong — kami membekalkan kepada syarikat mover, penjual online dan kilang di seluruh Lembah Klang. Untuk Puchong, sistemnya mudah: <strong class="text-on-surface font-semibold">WhatsApp senarai saiz dan kuantiti anda waktu pagi, dan kami aturkan penghantaran hari yang sama atau keesokan hari</strong>. Tak perlu keluar rumah, tak perlu sumbat 60 kotak dalam kereta.
      </p>
      <p>
        Harganya harga borong, bukan harga runcit. <a href="/used-carton-boxes" class="text-primary font-semibold hover:underline">Kotak terpakai</a> bermula dari RM0.90 sekotak — gred sekali guna dari kilang, setiap satu disemak, kering dan bebas bau. Kotak baru pula dari RM1.10 di <a href="/shop" class="text-primary font-semibold hover:underline">kedai online kami</a>. Tak pasti yang mana sesuai? Baca <a href="/blog/beza-kotak-baru-kotak-terpakai" class="text-primary font-semibold hover:underline">perbandingan kotak baru vs terpakai</a> — ramai pelanggan Puchong akhirnya campurkan kedua-duanya: terpakai untuk pakaian dan buku, baru untuk pinggan mangkuk.
      </p>
      <p>
        Untuk kondo dan rumah teres di Puchong, anggaran biasa ialah 50–70 kotak bagi kediaman 3 bilik — guna <a href="/blog/berapa-kotak-diperlukan-pindah-rumah" class="text-primary font-semibold hover:underline">panduan kiraan kotak kami</a> untuk angka yang lebih tepat, dan semak <a href="/kotak-pindah-rumah" class="text-primary font-semibold hover:underline">senarai harga penuh kotak pindah rumah</a> sebelum order. Tip daripada kami: tempah kotak seminggu dua sebelum tarikh pindah dan mula pack bilik yang jarang digunakan dahulu — lagi banyak tip dalam <a href="/blog/tips-pindah-rumah-packing-malaysia" class="text-primary font-semibold hover:underline">panduan packing pindah rumah</a> kami.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-surface-container-low">
    <div class="max-w-3xl mx-auto px-6 md:px-8">
      <h2 class="font-headline text-3xl font-extrabold tracking-tighter text-on-surface mb-8">Soalan lazim — kotak pindah {CITY}</h2>
      <div class="flex flex-col divide-y divide-outline-variant/15">
        {faqs.map(f => (
          <details class="group py-5">
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-headline font-bold text-lg text-on-surface">
              {f.q}
              <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-45 flex-shrink-0" style="font-size:24px;">add</span>
            </summary>
            <p class="font-body text-sm text-secondary leading-relaxed mt-3">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Nearby areas -->
  <section class="py-16 px-6 md:px-8 max-w-7xl mx-auto">
    <h2 class="font-headline text-2xl font-extrabold tracking-tighter text-on-surface mb-6">Kawasan berdekatan</h2>
    <div class="flex flex-wrap gap-3">
      <a href="/kotak-pindah-rumah/seri-kembangan" class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Kotak Pindah Seri Kembangan</a>
      <a href="/kotak-pindah-rumah/kuala-lumpur"   class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Kotak Pindah Kuala Lumpur</a>
      <a href="/kotak-pindah-rumah/putrajaya"      class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Kotak Pindah Putrajaya</a>
      <a href="/kotak-pindah-rumah"                class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Semua Kawasan →</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-primary-container text-on-primary-container">
    <div class="max-w-4xl mx-auto px-6 md:px-8 text-center">
      <h2 class="font-headline text-4xl md:text-5xl font-extrabold tracking-tighter mb-6">Pindah rumah di Puchong? Mula dengan satu mesej.</h2>
      <p class="font-body text-lg mb-10 opacity-90 max-w-xl mx-auto leading-relaxed">
        Hantar senarai saiz dan kuantiti kotak anda ke WhatsApp — kami balas dengan sebut harga dan aturkan penghantaran ke mana-mana kawasan Puchong, atau sediakan pesanan untuk diambil di gudang Balakong.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="bg-[#25D366] text-white px-10 py-4 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:bg-[#1ebd5a] transition-colors">
          WhatsApp 016-891 6381
        </a>
        <a href="https://www.google.com/maps/search/?api=1&query=Quinocycle+No.13+Jalan+Taming+P%2F1+Taming+Jaya+43300+Balakong+Selangor" target="_blank" rel="noopener noreferrer" class="bg-on-surface text-surface px-10 py-4 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-colors">
          Lokasi Gudang (Balakong)
        </a>
      </div>
    </div>
  </section>
</Layout>
