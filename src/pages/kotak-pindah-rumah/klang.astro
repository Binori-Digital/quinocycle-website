---
import Layout from '../../layouts/Layout.astro';

const CITY = 'Klang';
const WA_NUMBER = '60168916381';
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(`Hi Quinocycle! Saya nak beli kotak pindah rumah di ${CITY}.`)}`;

const faqs = [
  {
    q: 'Ada kilang kotak di Klang?',
    a: 'Soalan jujur perlukan jawapan jujur: Quinocycle bukan kilang, dan kami tiada kilang di Klang. Kami ialah gudang pembekal borong di Taming Jaya, Balakong — kami stok kotak dalam kuantiti besar terus dari sumber, jadi harga yang sampai kepada anda ialah harga kilang dari gudang pembekal, dihantar terus ke Klang dalam 1 hari bekerja. Kotak terpakai dari RM0.90, kotak baru dari RM1.10 sekotak. Lihat <a href="/kilang-kotak" class="text-primary font-semibold hover:underline">hab harga kilang kami</a> untuk perbandingan penuh.',
  },
  {
    q: 'Berapa lama penghantaran kotak ke Klang?',
    a: '1 hari bekerja untuk kebanyakan kawasan Klang — Bandar Klang, Bukit Tinggi, Bandar Botanic dan sekitar Port Klang. Sahkan pesanan anda melalui WhatsApp 016-891 6381 dan kotak bergerak dari gudang Balakong pada slot penghantaran terdekat. Percuma untuk pesanan melebihi RM300 (KL & Selangor); untuk kuantiti lebih kecil, kami beri sebut harga penghantaran terus dalam WhatsApp.',
  },
  {
    q: 'Boleh order kotak secara pukal untuk bisnes di Port Klang?',
    a: 'Boleh — malah itu antara jenis pesanan paling kerap kami terima dari Klang. Syarikat logistik, freight forwarder dan operator gudang sekitar Port Klang order kotak kadbod dalam ratusan unit untuk operasi repacking dan penghantaran. Minimum borong penuh RM1,000, dengan kuantiti minimum 50–200 unit bagi setiap saiz. Keperluan bawah tahap itu pun boleh diatur — hantar senarai anda melalui WhatsApp dan kami balas dengan sebut harga.',
  },
  {
    q: 'Boleh saya ambil sendiri kotak di gudang kalau tinggal di Klang?',
    a: 'Boleh, tapi kira dulu masa anda. Gudang kami di No.13, Jalan Taming P/1, Taming Jaya, 43300 Balakong — lebih kurang 40–45 minit memandu dari Klang. Untuk kebanyakan pelanggan Klang, penghantaran 1 hari bekerja lebih jimat masa dan minyak, apatah lagi pesanan melebihi RM300 dihantar percuma. Kalau tetap mahu datang, kami buka Isnin–Jumaat 9:00 pagi–5:00 petang dan Sabtu 9:00 pagi–1:00 tengah hari — WhatsApp dulu supaya pesanan anda siap dibungkus.',
  },
  {
    q: 'Where can I buy carton boxes in Klang? (English)',
    a: 'Instead of driving 40–45 minutes across the Klang Valley, order from Quinocycle — a wholesale carton box warehouse in Balakong that delivers to Klang and Port Klang within one working day. Prices are wholesale-grade: used boxes from RM0.90 each (stock rotates) and new boxes from RM1.10, with free delivery on orders above RM300 throughout KL and Selangor. Message WhatsApp 016-891 6381 for a quote or check live stock at shop.quinocycle.com.',
  },
];

const storeSchema = {
  "@context": "https://schema.org",
  "@type": "Store",
  "name": `Quinocycle — Kotak Pindah Rumah ${CITY}`,
  "description": `Pembekal kotak pindah rumah untuk kawasan ${CITY} — Bandar Klang, Bukit Tinggi, Bandar Botanic & Port Klang. Kotak kardus baru dan terpakai harga borong dari RM0.90 sekotak, penghantaran 1 hari bekerja dari gudang Balakong.`,
  "url": "https://www.quinocycle.com.my/kotak-pindah-rumah/klang/",
  "telephone": "+60168916381",
  "priceRange": "RM0.90 - RM8.00 sekotak",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "No.13, Jalan Taming P/1, Taming Jaya",
    "addressLocality": "Balakong",
    "addressRegion": "Selangor",
    "postalCode": "43300",
    "addressCountry": "MY"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 3.0579, "longitude": 101.7468 },
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "17:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "09:00", "closes": "13:00" }
  ],
  "areaServed": ["Klang","Bandar Klang","Bukit Tinggi","Bandar Botanic","Port Klang"]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://www.quinocycle.com.my/" },
    { "@type": "ListItem", "position": 2, "name": "Kotak Pindah Rumah", "item": "https://www.quinocycle.com.my/kotak-pindah-rumah/" },
    { "@type": "ListItem", "position": 3, "name": CITY, "item": "https://www.quinocycle.com.my/kotak-pindah-rumah/klang/" }
  ]
};
---

<Layout
  lang="ms"
  title={`Kotak Pindah Rumah ${CITY} — Hantar 1 Hari Bekerja Sampai Port Klang, dari RM0.90 | Quinocycle`}
  description={`Perlu kotak pindah rumah di ${CITY}? Kami hantar ke Bandar Klang, Bukit Tinggi, Bandar Botanic & Port Klang dalam 1 hari bekerja — kotak dari RM0.90, percuma untuk order RM300+. WhatsApp 016-891 6381.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(storeSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="pt-16 pb-12 px-6 md:px-8 max-w-7xl mx-auto">
    <nav class="font-body text-xs text-secondary mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary transition-colors">Utama</a>
      <span class="mx-2">/</span>
      <a href="/kotak-pindah-rumah" class="hover:text-primary transition-colors">Kotak Pindah Rumah</a>
      <span class="mx-2">/</span>
      <span class="text-on-surface font-semibold">{CITY}</span>
    </nav>
    <span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4 block">Kawasan Penghantaran Kami</span>
    <h1 class="font-headline text-4xl md:text-6xl font-extrabold tracking-tighter text-on-surface leading-[0.95] mb-6 max-w-4xl">
      Kotak pindah rumah {CITY} <br /><span class="text-primary italic">— tak payah merentas Lembah Klang.</span>
    </h1>
    <p class="font-body text-lg md:text-xl text-secondary max-w-2xl leading-relaxed mb-8">
      Gudang pembekal kotak borong terdekat dengan Klang berada di Balakong — 40 hingga 45 minit memandu. Jangan bazir masa dan tol: Quinocycle hantar terus ke <strong class="text-on-surface font-semibold">Bandar Klang, Bukit Tinggi, Bandar Botanic dan kawasan Port Klang</strong> dalam 1 hari bekerja. Kotak terpakai dari <strong class="text-on-surface font-semibold">RM0.90</strong>, kotak baru dari <strong class="text-on-surface font-semibold">RM1.10</strong> sekotak — penghantaran percuma untuk pesanan melebihi RM300.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-[#25D366] text-white px-8 py-3.5 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:bg-[#1ebd5a] transition-colors">
        WhatsApp Sekarang
      </a>
      <a href="/kotak-pindah-rumah#senarai-harga" class="bg-primary-container text-on-primary-container px-8 py-3.5 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-all">
        Senarai Harga Penuh
      </a>
    </div>
  </section>

  <!-- Local info -->
  <section class="py-16 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-6 md:px-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-surface rounded-3xl p-8">
        <span class="material-symbols-outlined text-3xl text-primary mb-3 block">local_shipping</span>
        <h2 class="font-headline font-bold text-lg text-on-surface mb-3">Penghantaran 1 Hari Bekerja</h2>
        <p class="font-body text-sm text-secondary leading-relaxed">
          Bandar Klang, Bukit Tinggi, Bandar Botanic hingga kawasan Port Klang — pesanan yang disahkan hari ini bergerak pada slot penghantaran keesokan hari bekerja. Percuma untuk pesanan melebihi RM300 (KL &amp; Selangor).
        </p>
      </div>
      <div class="bg-surface rounded-3xl p-8">
        <span class="material-symbols-outlined text-3xl text-primary mb-3 block">inventory_2</span>
        <h2 class="font-headline font-bold text-lg text-on-surface mb-3">Pukal Untuk Bisnes Pelabuhan</h2>
        <p class="font-body text-sm text-secondary leading-relaxed">
          Syarikat logistik dan freight forwarder sekitar Port Klang order terus dari gudang kami: minimum borong RM1,000, kuantiti minimum 50–200 unit setiap saiz. Harga kilang dari gudang pembekal — tanpa trip merentasi Lembah Klang.
        </p>
      </div>
      <div class="bg-surface rounded-3xl p-8">
        <span class="material-symbols-outlined text-3xl text-primary mb-3 block">schedule</span>
        <h2 class="font-headline font-bold text-lg text-on-surface mb-3">Waktu Urusan</h2>
        <p class="font-body text-sm text-secondary leading-relaxed">
          Isnin–Jumaat: 9:00 pagi – 5:00 petang<br />
          Sabtu: 9:00 pagi – 1:00 tengah hari<br />
          Ahad &amp; cuti umum: tutup. Hantar mesej WhatsApp bila-bila — kami balas seawal mungkin.
        </p>
      </div>
    </div>
  </section>

  <!-- Content block -->
  <section class="py-20 px-6 md:px-8 max-w-3xl mx-auto">
    <h2 class="font-headline text-3xl md:text-4xl font-extrabold tracking-tighter text-on-surface mb-6">Kenapa penduduk Klang order kotak dari kami?</h2>
    <div class="font-body text-secondary leading-relaxed flex flex-col gap-5 text-base md:text-lg">
      <p>
        Klang antara daerah paling besar di Selangor — dari Bandar Klang dan Bukit Tinggi hinggalah ke Bandar Botanic dan kawasan pelabuhan. Tapi bila tiba masa nak pindah rumah, pilihan kotak di sini terhad: kedai hardware jual sekeping RM8 hingga RM12, dan penjual online ambil masa berhari-hari untuk sampai. Pembekal borong sebenar pula terletak di Balakong — lebih kurang <strong class="text-on-surface font-semibold">40 hingga 45 minit memandu merentasi Lembah Klang</strong>. Jauh untuk satu trip semata-mata nak beli kotak. Sebab itulah kami terbalikkan urusannya: anda tak perlu datang ke gudang, gudang yang datang kepada anda. Pesanan ke Klang dihantar dalam <strong class="text-on-surface font-semibold">1 hari bekerja</strong>.
      </p>
      <p>
        Prosesnya ringkas. WhatsApp senarai saiz dan kuantiti ke 016-891 6381, kami balas dengan sebut harga borong, dan lori kami hantar terus ke Bukit Tinggi, Bandar Botanic atau mana-mana kawasan Klang pada hari bekerja berikutnya — percuma untuk pesanan melebihi RM300. Nak jimat maksimum? Pilih <a href="/kotak-terpakai" class="text-primary font-semibold hover:underline">kotak terpakai</a> dari RM0.90 sekotak: gred sekali guna dari kilang, setiap unit disemak, kering dan bebas bau. Untuk barang pecah belah, tambah beberapa kotak baru dari RM1.10 melalui <a href="/shop" class="text-primary font-semibold hover:underline">kedai online kami</a>. Keliru nak pilih yang mana? Baca <a href="/blog/beza-kotak-baru-kotak-terpakai" class="text-primary font-semibold hover:underline">perbandingan kotak baru vs terpakai</a>.
      </p>
      <p>
        Klang juga istimewa sebab kawasan pelabuhannya. Syarikat logistik, freight forwarder dan operator gudang sekitar Port Klang guna kotak kadbod dalam kuantiti besar setiap bulan — untuk repacking, konsolidasi dan penghantaran keluar. Daripada memandu jauh untuk restock, mereka order <a href="/used-carton-boxes" class="text-primary font-semibold hover:underline">used carton boxes</a> secara pukal dan kami hantar terus ke premis. Pesanan borong penuh bermula RM1,000 dengan kuantiti minimum 50–200 unit setiap saiz — <a href="/kilang-kotak" class="text-primary font-semibold hover:underline">harga kilang dari gudang pembekal</a>, tanpa perlu berurusan dengan kilang sendiri.
      </p>
      <p>
        Untuk pindah rumah biasa pula: rumah teres atau kondo 3 bilik di Klang selalunya perlukan 50–70 kotak campuran saiz. Guna <a href="/blog/berapa-kotak-diperlukan-pindah-rumah" class="text-primary font-semibold hover:underline">panduan kiraan kotak kami</a> untuk anggaran mengikut bilik, semak <a href="/kotak-pindah-rumah" class="text-primary font-semibold hover:underline">senarai harga penuh kotak pindah rumah</a>, dan kalau nak faham kenapa harga kotak berbeza-beza antara pembekal, baca <a href="/blog/harga-kotak-pindah-rumah" class="text-primary font-semibold hover:underline">pecahan harga kotak pindah rumah</a> kami. Order awal seminggu dua sebelum tarikh pindah — stok sentiasa ada, tapi penghantaran 1 hari bekerja paling selesa bila anda tak kejar masa.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-surface-container-low">
    <div class="max-w-3xl mx-auto px-6 md:px-8">
      <h2 class="font-headline text-3xl font-extrabold tracking-tighter text-on-surface mb-8">Soalan lazim — kotak pindah {CITY}</h2>
      <div class="flex flex-col divide-y divide-outline-variant/15">
        {faqs.map(f => (
          <details class="group py-5">
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-headline font-bold text-lg text-on-surface">
              {f.q}
              <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-45 flex-shrink-0" style="font-size:24px;">add</span>
            </summary>
            <p class="font-body text-sm text-secondary leading-relaxed mt-3" set:html={f.a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- English summary -->
  <section class="py-16 px-6 md:px-8 max-w-3xl mx-auto">
    <h2 class="font-headline text-2xl md:text-3xl font-extrabold tracking-tighter text-on-surface mb-5">Carton Box Klang — Wholesale Prices, Delivered</h2>
    <div class="font-body text-secondary leading-relaxed flex flex-col gap-4">
      <p>Need carton boxes in Klang without the long drive across the valley? Quinocycle is a wholesale carton box warehouse in Balakong, and we deliver to Bandar Klang, Bukit Tinggi, Bandar Botanic and the Port Klang area within one working day of your confirmed order. Used carton boxes cost RM0.90–RM6.00 each (the cheapest currently in stock is about RM1.70; stock rotates as new loads arrive), new boxes RM1.10–RM9.00 — genuine warehouse pricing that logistics firms and freight forwarders around Port Klang already buy in bulk.</p>
      <p>Delivery is free on orders above RM300 anywhere in KL and Selangor, which most house-moving orders of 50–70 boxes comfortably exceed. Send your sizes and quantities to WhatsApp 016-891 6381, or see <a href="/carton-box" class="text-primary font-semibold hover:underline">all carton box delivery areas</a> and <a href="https://shop.quinocycle.com" target="_blank" rel="noopener noreferrer" class="text-primary font-semibold hover:underline">live stock &amp; prices</a>.</p>
    </div>
  </section>

  <!-- Nearby areas -->
  <section class="py-16 px-6 md:px-8 max-w-7xl mx-auto">
    <h2 class="font-headline text-2xl font-extrabold tracking-tighter text-on-surface mb-6">Kawasan berdekatan</h2>
    <div class="flex flex-wrap gap-3">
      <a href="/kotak-pindah-rumah/shah-alam"    class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Kotak Pindah Shah Alam</a>
      <a href="/kotak-pindah-rumah/puchong"      class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Kotak Pindah Puchong</a>
      <a href="/kotak-pindah-rumah/kuala-lumpur" class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Kotak Pindah Kuala Lumpur</a>
      <a href="/kotak-pindah-rumah"              class="bg-surface-container-low hover:bg-primary-container text-on-surface px-6 py-3 rounded-full font-headline font-bold text-sm transition-colors">Semua Kawasan →</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-primary-container text-on-primary-container">
    <div class="max-w-4xl mx-auto px-6 md:px-8 text-center">
      <h2 class="font-headline text-4xl md:text-5xl font-extrabold tracking-tighter mb-6">Kotak sampai Klang esok. Mulakan hari ini.</h2>
      <p class="font-body text-lg mb-10 opacity-90 max-w-xl mx-auto leading-relaxed">
        Hantar senarai saiz dan kuantiti kotak anda ke WhatsApp — kami balas dengan sebut harga borong dan jadualkan penghantaran ke mana-mana kawasan Klang, dari Bukit Tinggi hingga Port Klang.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="bg-[#25D366] text-white px-10 py-4 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:bg-[#1ebd5a] transition-colors">
          WhatsApp 016-891 6381
        </a>
        <a href="https://www.google.com/maps/search/?api=1&query=Quinocycle+No.13+Jalan+Taming+P%2F1+Taming+Jaya+43300+Balakong+Selangor" target="_blank" rel="noopener noreferrer" class="bg-on-surface text-surface px-10 py-4 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-colors">
          Lokasi Gudang (Balakong)
        </a>
      </div>
    </div>
  </section>
</Layout>
