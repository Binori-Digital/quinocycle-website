---
import Layout from '../../layouts/Layout.astro';
import { newBoxes, usedBoxes, SHOP_URL } from '../../data/catalog';

const WA_NUMBER = '60168916381';
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=Hi%20Quinocycle!%20I%20would%20like%20to%20order%20carton%20boxes.`;

// All service areas — every area gets its own landing page or a dedicated blurb
const areas = [
  { name: 'Ampang',              href: '/carton-box/ampang',                 note: 'Ampang Jaya, Pandan Indah · same/next-day' },
  { name: 'Cheras',              href: '/kotak-pindah-rumah/cheras',         note: '±10–15 min from our warehouse' },
  { name: 'Batu Caves',          href: '/kotak-pindah-rumah/batu-caves',     note: 'Gombak & Selayang side · next-day' },
  { name: 'Selayang',            href: '/carton-box/setapak-selayang',       note: 'With Setapak · next-day delivery' },
  { name: 'Kajang',              href: '/kotak-pindah-rumah/kajang',         note: '±15 min via SILK · same-day' },
  { name: 'Bangi',               href: '/kotak-pindah-rumah/bangi',          note: 'Bandar Baru Bangi, UKM · same/next-day' },
  { name: 'Semenyih',            href: '/kotak-pindah-rumah/semenyih',       note: 'Eco Majestic, Setia Ecohill · same/next-day' },
  { name: 'Nilai',               href: '/carton-box/nilai',                  note: 'Nilai 3, industrial parks · next-day' },
  { name: 'Puchong',             href: '/kotak-pindah-rumah/puchong',        note: 'Bandar Puteri, IOI · same/next-day' },
  { name: 'Bandar Kinrara',      href: '/carton-box/sunway-kinrara',         note: 'With Sunway · same/next-day' },
  { name: 'Sunway',              href: '/carton-box/sunway-kinrara',         note: 'Bandar Sunway, Sunway South Quay' },
  { name: 'Petaling Jaya',       href: '/carton-box/petaling-jaya',          note: 'SS2, Sec 14–17, Kelana Jaya · next-day' },
  { name: 'Klang',               href: '/kotak-pindah-rumah/klang',          note: 'Bukit Tinggi, Port Klang · next-day' },
  { name: 'Shah Alam',           href: '/kotak-pindah-rumah/shah-alam',      note: 'All seksyen · next-day delivery' },
  { name: 'Taman Desa',          href: '/kotak-pindah-rumah/kuala-lumpur',   note: 'Old Klang Road side · same/next-day' },
  { name: 'Setapak',             href: '/carton-box/setapak-selayang',       note: 'Wangsa Maju, Danau Kota · next-day' },
  { name: 'Rawang',              href: '/kotak-pindah-rumah/rawang',         note: 'Country Homes, Tasik Puteri · 1–2 days' },
  { name: 'Damansara',           href: '/carton-box/damansara-sri-hartamas', note: 'TTDI, Damansara Heights/Utama' },
  { name: 'Sri Hartamas',        href: '/carton-box/damansara-sri-hartamas', note: 'With Mont Kiara side · next-day' },
  { name: 'Banting',             href: '/carton-box#banting',                note: 'Kuala Langat · 1–2 working days' },
  { name: 'Sepang',              href: '/kotak-pindah-rumah/klia',           note: 'Sepang, Salak Tinggi · next-day' },
  { name: 'KLIA',                href: '/kotak-pindah-rumah/klia',           note: 'Cargo & XXL boxes · next-day' },
];

const faqs = [
  {
    q: 'Where can I buy carton boxes near me in the Klang Valley?',
    a: 'Quinocycle is a wholesale carton box warehouse at No.13, Jalan Taming P/1, Taming Jaya, 43300 Balakong, Selangor. We deliver to 20+ areas across KL, Selangor and Nilai — usually same-day or next-day — or you can self-collect at the warehouse. Free delivery for KL & Selangor orders above RM300.',
  },
  {
    q: 'How much do carton boxes cost in Malaysia?',
    a: 'At wholesale prices: used once-used boxes from RM0.90–RM6.00 per box (cheapest in-stock model currently RM1.70; stock rotates), new boxes RM1.10–RM9.00, and XXL cargo boxes RM28–RM38. Retail hardware shops typically charge RM8–RM12 for a similar box. Check live stock at shop.quinocycle.com.',
  },
  {
    q: 'Do you sell small quantities or only wholesale?',
    a: 'Both. Full wholesale pricing applies from RM1,000 per order, but smaller quantities — for example 40–70 boxes for a house move — can be ordered via WhatsApp 016-891 6381 or our online store with delivery to your door.',
  },
  {
    q: 'Are used carton boxes strong enough for moving house?',
    a: 'Yes. Our used boxes are once-used factory grade — each one checked, dry and odour-free. Double-wall models (MG, Bary, BT, Yellow, PDC) handle books, kitchenware and full house moves. They cost 50–60% less than new boxes.',
  },
  {
    q: 'How fast is delivery to my area?',
    a: 'Same-day or next-day for most of the Klang Valley (Cheras, Kajang, Puchong, Ampang, PJ, Sunway, Setapak), next-day for Shah Alam, Klang, Nilai and KLIA/Sepang, and 1–2 working days for Rawang and Banting. Orders above RM300 ship free within KL & Selangor.',
  },
];

const storeSchema = {
  "@context": "https://schema.org",
  "@type": "Store",
  "name": "Quinocycle — Carton Box Supplier Malaysia",
  "description": "Wholesale carton box supplier in Balakong, Selangor. New and used carton boxes from RM0.90 per box, delivered same/next day across KL, Selangor and Nilai.",
  "url": "https://www.quinocycle.com.my/carton-box/",
  "telephone": "+60168916381",
  "priceRange": "RM0.90 - RM38.00 per box",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "No.13, Jalan Taming P/1, Taming Jaya",
    "addressLocality": "Balakong",
    "addressRegion": "Selangor",
    "postalCode": "43300",
    "addressCountry": "MY"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 3.0579, "longitude": 101.7468 },
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "17:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "09:00", "closes": "13:00" }
  ],
  "areaServed": ["Ampang","Cheras","Batu Caves","Selayang","Kajang","Bangi","Semenyih","Nilai","Puchong","Bandar Kinrara","Sunway","Petaling Jaya","Klang","Shah Alam","Taman Desa","Setapak","Rawang","Damansara","Sri Hartamas","Banting","Sepang","KLIA","Kuala Lumpur","Selangor"]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.quinocycle.com.my/" },
    { "@type": "ListItem", "position": 2, "name": "Carton Box Supplier — Areas We Serve", "item": "https://www.quinocycle.com.my/carton-box/" }
  ]
};

const priceHighlights = [
  ...usedBoxes.filter(b => b.inStock).slice(0, 4).map(b => ({ ...b, cond: 'Used' })),
  ...newBoxes.slice(0, 4).map(b => ({ ...b, cond: 'New' })),
];
---

<Layout
  lang="en"
  title="Carton Box Supplier Near You — Wholesale from RM0.90, 22 KL & Selangor Areas | Quinocycle"
  description="Looking for carton boxes in Ampang, Cheras, Kajang, PJ, Sunway, Shah Alam or anywhere in the Klang Valley? Quinocycle's Balakong warehouse delivers new & used carton boxes from RM0.90/box — same/next-day to 22 areas. WhatsApp 016-891 6381."
>
  <script type="application/ld+json" set:html={JSON.stringify(storeSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="pt-16 pb-12 px-6 md:px-8 max-w-7xl mx-auto">
    <nav class="font-body text-xs text-secondary mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-on-surface font-semibold">Carton Box — Areas We Serve</span>
    </nav>
    <span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4 block">One Warehouse · 22 Areas · Same/Next-Day</span>
    <h1 class="font-headline text-4xl md:text-6xl font-extrabold tracking-tighter text-on-surface leading-[0.95] mb-6 max-w-4xl">
      Carton box supplier <br /><span class="text-primary italic">near you — from RM0.90.</span>
    </h1>
    <!-- Direct answer (AEO) -->
    <p id="direct-answer" class="font-body text-lg md:text-xl text-secondary max-w-2xl leading-relaxed mb-8">
      Wherever you are in the Klang Valley — Ampang, Cheras, Kajang, Puchong, PJ, Sunway, Shah Alam, Klang or beyond — you don't need a carton box shop next door. Quinocycle's <strong class="text-on-surface font-semibold">wholesale warehouse in Balakong</strong> delivers new boxes from <strong class="text-on-surface font-semibold">RM1.10</strong> and checked used boxes from <strong class="text-on-surface font-semibold">RM0.90</strong> to your doorstep, usually same-day or next-day. Free delivery in KL &amp; Selangor for orders above RM300.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-[#25D366] text-white px-8 py-3.5 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:bg-[#1ebd5a] transition-colors">
        WhatsApp for a Quote
      </a>
      <a href={SHOP_URL} target="_blank" rel="noopener noreferrer" class="bg-primary-container text-on-primary-container px-8 py-3.5 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-all">
        Buy Online — Live Stock
      </a>
    </div>
  </section>

  <!-- Areas grid -->
  <section class="py-20 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary mb-3 block">Areas We Serve</span>
      <h2 class="font-headline text-3xl md:text-4xl font-extrabold tracking-tighter text-on-surface mb-4">Carton box delivery across KL &amp; Selangor.</h2>
      <p class="font-body text-secondary max-w-2xl leading-relaxed mb-10">
        Pick your area for local delivery details and prices. All stock ships from our Balakong warehouse — no middlemen, no retail markup.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {areas.map(a => (
          <a href={a.href} class="bg-surface hover:bg-primary-container rounded-3xl p-5 transition-colors group">
            <h3 class="font-headline font-bold text-base text-on-surface mb-1">Carton Box {a.name}</h3>
            <p class="font-body text-xs text-secondary group-hover:text-on-primary-container/80">{a.note}</p>
          </a>
        ))}
      </div>
      <p id="banting" class="font-body text-sm text-secondary mt-8 max-w-3xl leading-relaxed">
        <strong class="text-on-surface font-semibold">Banting &amp; Kuala Langat:</strong> we deliver carton boxes to Banting, Jenjarom and the Kuala Langat district within 1–2 working days — WhatsApp your quantity for a delivery quote. <strong class="text-on-surface font-semibold">Taman Desa &amp; Old Klang Road:</strong> covered under our <a href="/kotak-pindah-rumah/kuala-lumpur" class="text-primary font-semibold hover:underline">Kuala Lumpur delivery area</a>, usually same-day.
      </p>
    </div>
  </section>

  <!-- Price highlights -->
  <section class="py-20 px-6 md:px-8 max-w-5xl mx-auto">
    <span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary mb-3 block">Wholesale Price List</span>
    <h2 class="font-headline text-3xl md:text-4xl font-extrabold tracking-tighter text-on-surface mb-4">Same boxes. A fraction of the retail price.</h2>
    <p class="font-body text-secondary max-w-2xl leading-relaxed mb-10">
      Hardware shops charge RM8–RM12 per box. Buying direct from the warehouse, the same money buys you five to ten boxes. Live stock and the full 23-model catalogue at <a href={SHOP_URL} class="text-primary font-semibold hover:underline" target="_blank" rel="noopener noreferrer">shop.quinocycle.com</a>.
    </p>
    <div class="overflow-x-auto rounded-3xl border border-outline-variant/20">
      <table class="w-full text-left font-body text-sm">
        <thead>
          <tr class="bg-primary-container text-on-primary-container">
            <th class="px-5 py-4 font-headline font-bold uppercase tracking-wider text-xs">Box</th>
            <th class="px-5 py-4 font-headline font-bold uppercase tracking-wider text-xs">Size (mm)</th>
            <th class="px-5 py-4 font-headline font-bold uppercase tracking-wider text-xs">Condition</th>
            <th class="px-5 py-4 font-headline font-bold uppercase tracking-wider text-xs">Price / box</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-outline-variant/15">
          {priceHighlights.map(b => (
            <tr class="bg-surface hover:bg-surface-container-low transition-colors">
              <td class="px-5 py-4 font-semibold text-on-surface whitespace-nowrap">{b.name}</td>
              <td class="px-5 py-4 whitespace-nowrap">{b.dims}</td>
              <td class="px-5 py-4">{b.cond}{b.wall ? ` · ${b.wall}` : ''}</td>
              <td class="px-5 py-4 font-headline font-bold text-on-surface whitespace-nowrap">RM {b.price.toFixed(2)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="font-body text-xs text-secondary mt-4">
      Fixed wholesale pricing. Used-box stock rotates — the RM0.90 model is subject to availability; in-stock used boxes currently start at RM1.70. XXL cargo boxes (760–800mm) RM28–RM38. Full wholesale from RM1,000/order; smaller house-move quantities via <a href={WA_LINK} class="text-primary font-semibold hover:underline" target="_blank" rel="noopener noreferrer">WhatsApp</a>.
    </p>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-surface-container-low">
    <div class="max-w-3xl mx-auto px-6 md:px-8">
      <h2 class="font-headline text-3xl font-extrabold tracking-tighter text-on-surface mb-8">Carton box FAQ</h2>
      <div class="flex flex-col divide-y divide-outline-variant/15">
        {faqs.map(f => (
          <details class="group py-5">
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-headline font-bold text-lg text-on-surface">
              {f.q}
              <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-45 flex-shrink-0" style="font-size:24px;">add</span>
            </summary>
            <p class="font-body text-sm text-secondary leading-relaxed mt-3">{f.a}</p>
          </details>
        ))}
      </div>
      <p class="font-body text-sm text-secondary mt-8">
        Bahasa Malaysia? Lihat <a href="/kotak-pindah-rumah" class="text-primary font-semibold hover:underline">senarai harga kotak pindah rumah</a>. 中文指南: <a href="/blog/malaysia-banjia-zhixiang-guide" class="text-primary font-semibold hover:underline">马来西亚搬家纸箱指南</a>.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-primary-container text-on-primary-container">
    <div class="max-w-4xl mx-auto px-6 md:px-8 text-center">
      <h2 class="font-headline text-4xl md:text-5xl font-extrabold tracking-tighter mb-6">Boxes to your door — today or tomorrow.</h2>
      <p class="font-body text-lg mb-10 opacity-90 max-w-xl mx-auto leading-relaxed">
        WhatsApp your area, sizes and quantity — we confirm stock and delivery within one working hour.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="bg-[#25D366] text-white px-10 py-4 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:bg-[#1ebd5a] transition-colors">
          WhatsApp 016-891 6381
        </a>
        <a href="/shop" class="bg-on-surface text-surface px-10 py-4 rounded-full font-headline font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-colors">
          Browse Catalogue
        </a>
      </div>
    </div>
  </section>
</Layout>
