const articleSchema = { "@context":"https://schema.org","@type":"Article", headline: post.title, description: post.description, datePublished: '2026-04-30', dateModified: '2026-04-30', inLanguage:"en-MY", author:{name:"Quinocycle Team",url:"https://www.quinocycle.com.my"}, publisher:{name:"Quinocycle Sdn. Bhd.",logo:{url:"https://www.quinocycle.com.my/logo.png"}}, mainEntityOfPage:{url:"https://www.quinocycle.com.my/blog/bubble-wrap-orchid-exotic-plant-airfreight-0430"}, keywords:"bubble wrap live plants Malaysia, orchid air freight packaging Selangor, anthurium export bubble wrap Balakong, plant export packaging Cheras, exotic plant courier Kajang, KLIA cargo plant packaging" };
const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Why use bubble wrap for live plant air freight?","acceptedAnswer":{"@type":"Answer","text":"Bubble wrap protects delicate flowers, leaves, and root systems from impact during cargo handling and acts as a moisture-buffering layer that helps maintain humidity around the plant during 12-24 hour transit. It also cushions against pressure changes in the unheated cargo hold and prevents stems from snapping during conveyor handling at KLIA Cargo and connecting hubs."}},{"@type":"Question","name":"What bubble size is best for orchids and exotic plants?","acceptedAnswer":{"@type":"Answer","text":"Small bubble (10mm) for delicate flower spikes and orchid blooms — fine air cells distribute pressure without crushing petals. Medium bubble (20mm) for the body of the plant, leaves, and pot. Large bubble (30mm) for outer cushioning layer in the box. The three-layer combination is the standard used by Malaysian orchid exporters shipping to Tokyo, Seoul, and Amsterdam."}},{"@type":"Question","name":"Does bubble wrap interfere with plant respiration during long flights?","acceptedAnswer":{"@type":"Answer","text":"Plants in transit are largely dormant due to dark conditions, so respiration is minimal. The crucial factor is preventing root desiccation and impact damage — both of which bubble wrap addresses well. Wrap leaves and bloom areas loosely (single layer, not airtight) and ensure the box itself has small ventilation perforations as required by destination phytosanitary rules."}},{"@type":"Question","name":"How do I package an orchid for KLIA Cargo air freight?","acceptedAnswer":{"@type":"Answer","text":"Wrap pot and root ball in moistened sphagnum moss inside a plastic bag, then bubble wrap the bag. Wrap the plant body and bloom spike in a loose cone of small-bubble wrap, leaving leaf tips slightly exposed for airflow. Place inside a custom-fit corrugated carton with ventilation holes, label with phytosanitary certificate, orchid species, and 'LIVE PLANTS' on all sides. Total kit time per orchid: 4-5 minutes."}},{"@type":"Question","name":"What quantities do exporters typically order?","acceptedAnswer":{"@type":"Answer","text":"Mid-size orchid exporters at Cameron Highlands and Selangor nurseries typically order 100-500 metres of bubble wrap monthly across the three sizes. We supply in jumbo rolls (rolls of 100m+) for cost efficiency, plus pre-cut sheet packs for smaller producers. Cameron-bound delivery and Klang Valley nursery delivery scheduled weekly."}}]};
const localBusinessSchema = { "@context":"https://schema.org","@type":"Store", name:"Quinocycle Sdn. Bhd.", url:"https://www.quinocycle.com.my", telephone:"+60168916381", address:{streetAddress:"No.13, Jalan Taming P/1, Taming Jaya", addressLocality:"Balakong", addressRegion:"Selangor", postalCode:"43300", addressCountry:"MY"}, geo:{latitude:3.0579,longitude:101.7468}, openingHoursSpecification:[{dayOfWeek:["Monday","Tuesday","Wednesday","Thursday","Friday"],opens:"09:00",closes:"17:00"},{dayOfWeek:"Saturday",opens:"09:00",closes:"13:00"}], priceRange:"RM 1.90 – RM 6.50 per box", areaServed:"Peninsular Malaysia" };
