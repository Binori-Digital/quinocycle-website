const articleSchema = { "@context":"https://schema.org","@type":"Article", headline: post.title, description: post.description, datePublished: '2026-04-29', dateModified: '2026-04-29', inLanguage:"en-MY", author:{name:"Quinocycle Team",url:"https://www.quinocycle.com.my"}, publisher:{name:"Quinocycle Sdn. Bhd.",logo:{url:"https://www.quinocycle.com.my/logo.png"}}, mainEntityOfPage:{url:"https://www.quinocycle.com.my/blog/wholesale-kedai-runcit-sundry-shop-reseller-0429"}, keywords:"kedai runcit packaging Malaysia, sundry shop wholesale boxes Selangor, mini market reseller Balakong, kampung shop packaging Cheras, traditional retail boxes Klang Valley, neighbourhood store carton Kajang" };
