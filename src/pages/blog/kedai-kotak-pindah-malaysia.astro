    <img
      src="/images/blog-movers-guide.jpg"
      alt="Kotak kardus tersusun untuk pindah rumah di Malaysia — Quinocycle Balakong Selangor"
      style="width:100%;max-height:460px;object-fit:cover;border-radius:var(--radius);border:1px solid var(--border);display:block;"
      loading="eager"
      width="1280"
      height="720"
    />
