      <h1 class="article-hero__title">{post.title}</h1>
      <div class="article-meta">
        <time datetime={post.dateModified}>Dikemaskini {new Date(post.dateModified).toLocaleDateString('ms-MY', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
