const articleSchema = { "@context":"https://schema.org","@type":"Article", headline: post.title, description: post.description, datePublished: '2026-02-10', dateModified: '2026-07-02', inLanguage:"en-MY", author:{name:"Quinocycle Team",url:"https://www.quinocycle.com.my"}, publisher:{name:"Quinocycle Sdn. Bhd.",logo:{url:"https://www.quinocycle.com.my/logo.png"}}, mainEntityOfPage:{url:"https://www.quinocycle.com.my/blog/eco-packaging-used-boxes-business"}, keywords:"eco packaging Malaysia, recycled carton box, sustainable packaging business, kotak terpakai mesra alam, green packaging Selangor, reuse carton box Balakong" };
const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is reusing a carton box better than recycling it?","acceptedAnswer":{"@type":"Answer","text":"Yes. Recycling still consumes energy, water, and transport to pulp and re-manufacture the board. Reuse skips all of that — the box simply does another journey. A carton reused two or three times before recycling has a far smaller footprint per trip than a new box each time."}},{"@type":"Question","name":"Do customers actually care about eco-friendly packaging?","acceptedAnswer":{"@type":"Answer","text":"Increasingly, yes. Surveys across Southeast Asia consistently show a majority of consumers — especially under 35 — prefer brands with sustainable packaging, and many are willing to pay slightly more. A simple note that your parcel ships in a reused carton turns a cost saving into a brand story."}},{"@type":"Question","name":"Does eco-friendly packaging cost more?","acceptedAnswer":{"@type":"Answer","text":"Used cartons are the rare sustainability move that costs less, not more — 40-60% below new-box prices. Unlike compostable mailers or recycled-content premium papers, switching to reused boxes saves money from the first parcel."}},{"@type":"Question","name":"How do I tell customers my packaging is reused without looking cheap?","acceptedAnswer":{"@type":"Answer","text":"Own it. A sticker or thank-you card saying 'this box is on its second journey — reused to reduce waste' reframes the scuffed carton as a deliberate choice. Customers respond well to honesty; they respond badly only to unexplained shabby packaging."}},{"@type":"Question","name":"Where can I buy used carton boxes in bulk in Malaysia?","acceptedAnswer":{"@type":"Answer","text":"Quinocycle in Balakong, Selangor supplies graded used carton boxes wholesale — inspected for strength and cleanliness — from RM 1.90 per box, with delivery across Klang Valley and Peninsular Malaysia."}}]};
const localBusinessSchema = { "@context":"https://schema.org","@type":"Store", name:"Quinocycle Sdn. Bhd.", url:"https://www.quinocycle.com.my", telephone:"+60168916381", address:{streetAddress:"No.13, Jalan Taming P/1, Taming Jaya", addressLocality:"Balakong", addressRegion:"Selangor", postalCode:"43300", addressCountry:"MY"}, geo:{latitude:3.0579,longitude:101.7468}, openingHoursSpecification:[{dayOfWeek:["Monday","Tuesday","Wednesday","Thursday","Friday"],opens:"09:00",closes:"17:00"},{dayOfWeek:"Saturday",opens:"09:00",closes:"13:00"}], priceRange:"RM 1.90 – RM 6.50 per box", areaServed:"Peninsular Malaysia" };
---
<Layout title={post.title} description={post.description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <article class="max-w-4xl mx-auto px-6 md:px-8 pt-16 pb-24">
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-4">
