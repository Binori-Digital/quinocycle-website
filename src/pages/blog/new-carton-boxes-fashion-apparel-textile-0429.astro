const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What size carton works best for folded apparel orders?","acceptedAnswer":{"@type":"Answer","text":"For single-piece online orders we recommend 280x200x80mm single-wall mailers. Multi-piece bulk shipments to retailers fit best in 500x350x250mm 5-ply double-wall cartons. We can custom-size to your most common SKU mix."}},{"@type":"Question","name":"Will the carton damage delicate fabrics like silk or chiffon?","acceptedAnswer":{"@type":"Answer","text":"Our virgin kraft inner liner is smooth and lint-free, so it does not snag silk, chiffon, or organza. For premium pieces we recommend an extra acid-free tissue layer between the garment and the carton wall."}},{"@type":"Question","name":"Do you supply cartons for batik and traditional textile shipments?","acceptedAnswer":{"@type":"Answer","text":"Yes. Many of our regular customers are batik makers in Selangor and Kelantan-origin shops in KL. We supply flat-pack cartons sized for folded sarongs, baju kurung sets, and rolled batik metres."}},{"@type":"Question","name":"Can you print our brand logo on the outside of the box?","acceptedAnswer":{"@type":"Answer","text":"Yes. 1-4 colour flexographic printing is available from 1,000 cartons upward. Lead time is 7-10 working days from artwork sign-off. We also offer custom inside-print for unboxing impact."}},{"@type":"Question","name":"What is the minimum order for fashion brand cartons?","acceptedAnswer":{"@type":"Answer","text":"Our company-wide minimum order is RM 1,000. This typically equates to 300-500 mailer boxes plus consumables, which suits most boutique brands and growing online sellers."}}]};
