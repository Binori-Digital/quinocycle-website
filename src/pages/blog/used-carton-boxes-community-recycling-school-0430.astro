const WA_LINK = 'https://wa.me/60168916381?text=Hi%20Quinocycle!%20I%20need%20used%20boxes%20for%20a%20recycling%20drive.';
const articleSchema = { "@context":"https://schema.org","@type":"Article", headline: post.title, description: post.description, datePublished: '2026-04-30', dateModified: '2026-04-30', inLanguage:"en-MY", author:{name:"Quinocycle Team",url:"https://www.quinocycle.com.my"}, publisher:{name:"Quinocycle Sdn. Bhd.",logo:{url:"https://www.quinocycle.com.my/logo.png"}}, mainEntityOfPage:{url:"https://www.quinocycle.com.my/blog/used-carton-boxes-community-recycling-school-0430"}, keywords:"used carton boxes recycling drive Malaysia, school recycling program Selangor, community collection boxes Balakong, NGO recycling Cheras, sekolah kitar semula Kajang, charity collection boxes Klang Valley" };
const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can used carton boxes be used for school recycling programs?","acceptedAnswer":{"@type":"Answer","text":"Yes — used carton boxes are ideal because they're affordable, sturdy enough to hold paper, plastic bottles, or aluminium cans, and the act of using recycled containers reinforces the recycling lesson itself. They cost RM 0.50 to RM 2.50 each in bulk depending on size, far cheaper than buying new collection bins."}},{"@type":"Question","name":"What size boxes work best for collection drives?","acceptedAnswer":{"@type":"Answer","text":"Medium boxes around 40×30×30cm work for most paper, plastic, and aluminium can collection. Larger boxes (50×40×40cm and up) suit clothing donations, books, and bulky textiles. We typically recommend a mix — 60% medium, 40% large — so collection points can sort by material type."}},{"@type":"Question","name":"How many boxes does a typical school program need?","acceptedAnswer":{"@type":"Answer","text":"A primary school of 600 students running a one-week paper drive typically uses 30-50 boxes. A neighbourhood community drive across 200 households uses 40-80 boxes. We supply in pallet quantities (50-100 boxes) at deeply discounted rates for educational and NGO programs in Selangor."}},{"@type":"Question","name":"Are the boxes clean and safe for children to handle?","acceptedAnswer":{"@type":"Answer","text":"Yes — our used boxes are sourced from clean retail and warehouse environments. They are not from food, chemical, or industrial waste streams. They arrive folded flat, easy to assemble by students with minimal supervision, and clean enough to handle without gloves."}},{"@type":"Question","name":"Do you offer special pricing for schools and NGOs?","acceptedAnswer":{"@type":"Answer","text":"Yes — we run a community-rate program for registered schools, MOE-recognized education programs, and NGOs operating recycling or charity drives in Selangor. Contact us with your program details, expected box quantity, and collection date. We aim to support local sustainability efforts wherever the budget allows."}}]};
const localBusinessSchema = { "@context":"https://schema.org","@type":"Store", name:"Quinocycle Sdn. Bhd.", url:"https://www.quinocycle.com.my", telephone:"+60168916381", address:{streetAddress:"No.13, Jalan Taming P/1, Taming Jaya", addressLocality:"Balakong", addressRegion:"Selangor", postalCode:"43300", addressCountry:"MY"}, geo:{latitude:3.0579,longitude:101.7468}, openingHoursSpecification:[{dayOfWeek:["Monday","Tuesday","Wednesday","Thursday","Friday"],opens:"09:00",closes:"17:00"},{dayOfWeek:"Saturday",opens:"09:00",closes:"13:00"}], priceRange:"RM 1.90 – RM 6.50 per box", areaServed:"Peninsular Malaysia" };
---
<Layout title={post.title} description={post.description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <article class="max-w-4xl mx-auto px-6 md:px-8 pt-16 pb-24">
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-4">
        <span class="bg-primary/20 text-primary font-label font-bold text-xs uppercase tracking-widest px-3 py-1 rounded-full">{post.category}</span>
        <time class="font-body text-sm text-secondary">{post.date}</time>
      </div>
      <h1 class="font-headline text-3xl md:text-4xl font-extrabold tracking-tighter text-on-surface mb-4">{post.title}</h1>
      <p class="font-body text-lg text-secondary leading-relaxed">{post.description}</p>
    </header>

    <div class="prose prose-lg max-w-none">
      <section class="mb-12">
        <p class="font-body text-on-surface leading-relaxed mb-6">If you are organising a recycling drive at a school, residents' association, surau, or community centre in Selangor, your collection containers matter more than you think. Plastic bins are expensive. Buying brand-new boxes works against the message of the campaign itself. Used carton boxes solve both problems — they are affordable, they reinforce the reuse-and-recycle lesson visually, and they handle every common collection material from old newspapers to clothing donations. Here is the practical playbook from working with dozens of community programs.</p>
      </section>

      <section class="mb-12">
        <h2 class="font-headline text-2xl font-bold text-on-surface mb-6">Why Used Cartons Are the Right Tool for Collection Drives</h2>
        <h3 class="font-headline text-xl font-bold text-on-surface mb-4">The Cost Math</h3>
        <p class="font-body text-on-surface leading-relaxed mb-6">A 50-box drive run with new boxes costs RM 200-300. The same drive with used boxes costs RM 50-100. For a PIBG-funded school program or a self-organised neighbourhood drive, that gap funds the prizes, the certificates, and the celebration party at the end. Save the budget for the people doing the work.</p>

        <h3 class="font-headline text-xl font-bold text-on-surface mb-4">The Educational Message</h3>
        <p class="font-body text-on-surface leading-relaxed mb-6">When students or residents drop their recyclables into a box that is itself being reused, the lesson is delivered without anyone having to explain it. Pristine plastic bins teach disposal; used cartons teach a circular economy. The teachers we have supplied tell us the unspoken message lands hardest with primary-age kids.</p>

        <h3 class="font-headline text-xl font-bold text-on-surface mb-4">Disposability After the Drive</h3>
        <p class="font-body text-on-surface leading-relaxed mb-6">After the campaign ends, the used boxes themselves get added to the paper-recycling stream. No long-term storage problem, no plastic-bin warehouse, no sunk asset to manage. The cycle closes itself.</p>
      </section>

      <section class="mb-12">
        <h2 class="font-headline text-2xl font-bold text-on-surface mb-6">Setting Up a Drive — Box Selection by Material</h2>
        <h3 class="font-headline text-xl font-bold text-on-surface mb-4">Paper, Newspapers & Magazines</h3>
        <p class="font-body text-on-surface leading-relaxed mb-6">Medium boxes (40×30×30cm) hold roughly 8-10kg of newspapers when filled. Cut a wide slot in the top with a marker box outline so people drop, not place. Print or stencil "PAPER ONLY" in bold block letters on all four sides. Recommended ratio: 30% of total drive boxes.</p>

        <h3 class="font-headline text-xl font-bold text-on-surface mb-4">Plastic Bottles & Aluminium Cans</h3>
        <p class="font-body text-on-surface leading-relaxed mb-6">Same medium size, but with a smaller round hole (18cm diameter) cut on top — that prevents non-recyclables being tossed in. Line the inside with a clear plastic bag if liquids are a risk (it usually is). Recommended ratio: 30% of total drive boxes.</p>

        <h3 class="font-headline text-xl font-bold text-on-surface mb-4">Clothing, Books & Bulky Donations</h3>
        <p class="font-body text-on-surface leading-relaxed mb-6">Large boxes (50×40×40cm and up) — open-top, no slot. Easy to fold up at the end and hand straight to the receiving NGO or charity. Recommended ratio: 40% of total drive boxes if your program includes clothing or book donations.</p>
      </section>

      <section class="mb-12">
        <h2 class="font-headline text-2xl font-bold text-on-surface mb-6">Logistics from Quinocycle Balakong</h2>
        <p class="font-body text-on-surface leading-relaxed mb-6">We supply used boxes from our Balakong warehouse to schools and community programs across Cheras, Kajang, Seri Kembangan, Bandar Mahkota, Sungai Long, and the wider Klang Valley. Boxes ship folded flat on pallets — 100 boxes occupies about 2 cubic metres. For programs registered as PIBG, MOE-aligned, or NGO-led, we offer a community discount and prioritise dispatch ahead of commercial orders.</p>
      </section>

      <div class="bg-surface-variant/50 border border-outline-variant/20 rounded-lg p-8 my-12">
        <h3 class="font-headline text-xl font-bold text-on-surface mb-6">Recycling Drive Box Mix — 50-Box Starter Plan</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <p class="font-label text-primary font-bold text-sm mb-2">PAPER COLLECTION</p>
            <p class="font-body text-on-surface text-sm">15 medium boxes with slot — ~8-10kg each</p>
          </div>
          <div>
            <p class="font-label text-primary font-bold text-sm mb-2">PLASTIC & CANS</p>
            <p class="font-body text-on-surface text-sm">15 medium boxes with round hole, plastic-lined</p>
          </div>
          <div>
            <p class="font-label text-primary font-bold text-sm mb-2">CLOTHING / BOOKS</p>
            <p class="font-body text-on-surface text-sm">20 large open-top boxes — bulk-friendly</p>
          </div>
          <div>
            <p class="font-label text-primary font-bold text-sm mb-2">TOTAL COST</p>
            <p class="font-body text-on-surface text-sm">RM 60-110 with community-rate discount</p>
          </div>
        </div>
      </div>

      <section class="mb-12">
        <h2 class="font-headline text-2xl font-bold text-on-surface mb-6">Recycling Drive FAQs</h2>
        <div class="space-y-4">
          <details class="group border border-outline-variant/20 rounded-lg p-4">
            <summary class="font-label font-bold text-on-surface cursor-pointer">Can used boxes be used for school recycling programs?</summary>
            <p class="font-body text-on-surface text-sm mt-3 leading-relaxed">Yes — affordable, sturdy, and the reuse itself reinforces the lesson. RM 0.50-2.50 each in bulk.</p>
          </details>
          <details class="group border border-outline-variant/20 rounded-lg p-4">
            <summary class="font-label font-bold text-on-surface cursor-pointer">What sizes work best?</summary>
            <p class="font-body text-on-surface text-sm mt-3 leading-relaxed">Medium 40×30×30cm for paper/plastic, large 50×40×40cm+ for clothing/books donation drives.</p>
          </details>
          <details class="group border border-outline-variant/20 rounded-lg p-4">
            <summary class="font-label font-bold text-on-surface cursor-pointer">How many boxes does a school need?</summary>
            <p class="font-body text-on-surface text-sm mt-3 leading-relaxed">600-student primary school running a 1-week drive: 30-50 boxes. Pallet-rate discount available.</p>
          </details>
          <details class="group border border-outline-variant/20 rounded-lg p-4">
            <summary class="font-label font-bold text-on-surface cursor-pointer">Are the boxes safe for kids?</summary>
            <p class="font-body text-on-surface text-sm mt-3 leading-relaxed">Yes — sourced from clean retail/warehouse, not food, chemical, or industrial streams.</p>
          </details>
          <details class="group border border-outline-variant/20 rounded-lg p-4">
            <summary class="font-label font-bold text-on-surface cursor-pointer">Special pricing for schools and NGOs?</summary>
            <p class="font-body text-on-surface text-sm mt-3 leading-relaxed">Yes — community-rate program for schools, MOE programs, and registered NGOs. WhatsApp us.</p>
          </details>
        </div>
      </section>

      <section class="mb-12 bg-primary/5 border border-primary/20 rounded-lg p-8">
        <h2 class="font-headline text-2xl font-bold text-on-surface mb-4">Used Boxes for Your Recycling Drive — Community Rate</h2>
        <p class="font-body text-on-surface leading-relaxed mb-6">Schools, PIBG, NGOs, and surau-led recycling programs across Selangor — talk to us about used boxes for your next drive. Community-rate pricing, fast delivery from Balakong, and we can help you spec the right mix.</p>
        <p class="font-body text-on-surface mb-6"><strong>Contact Quinocycle today:</strong></p>
        <ul class="font-body text-on-surface text-sm space-y-2 mb-6">
          <li>📞 <strong>Phone:</strong> +60 16 8916 381 / 03-8962 6381</li>
          <li>📧 <strong>Email:</strong> quinocycle@gmail.com</li>
          <li>📍 <strong>Address:</strong> No.13, Jalan Taming P/1, Taming Jaya, Balakong, Selangor 43300</li>
        </ul>
        <a href={WA_LINK} class="inline-block bg-primary text-on-primary font-label font-bold text-sm px-6 py-3 rounded-lg hover:opacity-90 transition-opacity">💬 Chat on WhatsApp</a>
      </section>

      <section class="mb-8">
        <h2 class="font-headline text-2xl font-bold text-on-surface mb-4">Conclusion: The Box That Teaches the Lesson</h2>
        <p class="font-body text-on-surface leading-relaxed mb-4">A recycling drive is half logistics, half message. The right collection container does both jobs at once. Used carton boxes hit the budget target, reinforce the educational message, and dispose cleanly into the paper stream when the program ends. For Klang Valley schools and community organisers, this is the most cost-effective and on-message option available.</p>
        <p class="font-body text-on-surface leading-relaxed">WhatsApp us with your program date and box count — we will get a community-rate quote back within hours.</p>
      </section>
    </div>
  </article>
</Layout>
