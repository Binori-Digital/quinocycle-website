const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can honeycomb cardboard be used as warehouse mezzanine flooring?","acceptedAnswer":{"@type":"Answer","text":"Yes — for light-storage mezzanines holding inventory boxes, slow-moving stock, or seasonal goods (not heavy equipment or vehicles). Honeycomb panels with steel-frame support carry 250-500kg/m² evenly distributed loads, which covers most carton-storage applications. Always specify the load rating to your structural engineer before installation."}},{"@type":"Question","name":"How does honeycomb compare to plywood mezzanine decking?","acceptedAnswer":{"@type":"Answer","text":"Honeycomb panels weigh 70% less than plywood at equivalent stiffness — about 4-6 kg/m² versus 14-18 kg/m². Lower dead load on the supporting frame means thinner steel sections and lower overall installation cost. Honeycomb also resists moisture warping if you use water-resistant kraft and is fully recyclable at end-of-life."}},{"@type":"Question","name":"What thickness of honeycomb is needed for mezzanine use?","acceptedAnswer":{"@type":"Answer","text":"Standard mezzanine decking uses 30mm or 50mm honeycomb sandwich panels. The 30mm spec handles up to 350kg/m² point load with steel joists at 600mm centres. The 50mm spec handles up to 500kg/m² and reduces joist count. We supply both with engineered facing kraft for foot-traffic durability."}},{"@type":"Question","name":"Is honeycomb mezzanine flooring fire-rated?","acceptedAnswer":{"@type":"Answer","text":"Standard honeycomb is paper-based and combustible. For warehouse applications subject to local Bomba (fire authority) approval, we supply fire-retardant treated honeycomb panels with Class 2 surface spread of flame rating. These cost about 25% more than standard but pass commercial warehouse inspection requirements in Selangor."}},{"@type":"Question","name":"Can it be installed by my regular maintenance team?","acceptedAnswer":{"@type":"Answer","text":"Yes — installation is significantly simpler than plywood. Panels arrive cut to your floor plan dimensions, weigh under 50kg per typical 2.4m × 1.2m unit (one-person lift), and screw directly to the steel frame using standard self-tapping screws. A two-person crew can deck a 100m² mezzanine in a single day."}}]};
