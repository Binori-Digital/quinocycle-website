const articleSchema = { "@context":"https://schema.org","@type":"Article", headline: post.title, description: post.description, datePublished: '2026-04-29', dateModified: '2026-04-29', inLanguage:"en-MY", author:{name:"Quinocycle Team",url:"https://www.quinocycle.com.my"}, publisher:{name:"Quinocycle Sdn. Bhd.",logo:{url:"https://www.quinocycle.com.my/logo.png"}}, mainEntityOfPage:{url:"https://www.quinocycle.com.my/blog/corrugated-cardboard-pallet-interleaving-sheets-0429"}, keywords:"pallet layer pads Malaysia, corrugated interleaving sheets Selangor, pallet divider sheets Balakong, warehouse layer pads Cheras, cardboard pallet covers Kajang, layer board Klang Valley" };
const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What size do most pallet interleaving sheets need to be?","acceptedAnswer":{"@type":"Answer","text":"Standard Malaysian pallets are 1100x1100mm (square) or 1200x1000mm (Euro-style). We supply both as off-the-shelf cuts, plus made-to-measure for non-standard pallets. Add 10mm tolerance so the sheet sits flat without overhang."}},{"@type":"Question","name":"What thickness should layer pads be for stacking heavy SKUs?","acceptedAnswer":{"@type":"Answer","text":"For loads under 200kg per layer, 3-ply C-flute is fine. For 200-500kg layers (cans, bottles, ceramic tiles), use 5-ply double-wall. For 500kg+ industrial loads, BC double-wall or honeycomb panels."}},{"@type":"Question","name":"Do I need layer pads if my products are already in cartons?","acceptedAnswer":{"@type":"Answer","text":"Yes, especially for stack heights above 1.6m. Layer pads spread point-load from the layer above evenly across the cartons below, preventing crushed corners — the leading cause of warehouse damage in Malaysia."}},{"@type":"Question","name":"Can the sheets be printed with our company name?","acceptedAnswer":{"@type":"Answer","text":"Yes — single colour flexo print is available from 5,000 sheets upward. Most customers print their company name and a 'KEEP DRY' or 'THIS WAY UP' indicator. Custom print lead time is 7-10 working days."}},{"@type":"Question","name":"How fast can you supply 5,000 sheets?","acceptedAnswer":{"@type":"Answer","text":"Standard sizes ship within 3-5 working days from our Balakong factory. Custom-cut and printed orders take 7-10 working days. Rush production possible for urgent orders — WhatsApp us with the spec."}}]};
