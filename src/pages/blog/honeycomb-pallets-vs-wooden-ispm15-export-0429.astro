const articleSchema = { "@context":"https://schema.org","@type":"Article", headline: post.title, description: post.description, datePublished: '2026-04-29', dateModified: '2026-04-29', inLanguage:"en-MY", author:{name:"Quinocycle Team",url:"https://www.quinocycle.com.my"}, publisher:{name:"Quinocycle Sdn. Bhd.",logo:{url:"https://www.quinocycle.com.my/logo.png"}}, mainEntityOfPage:{url:"https://www.quinocycle.com.my/blog/honeycomb-pallets-vs-wooden-ispm15-export-0429"}, keywords:"honeycomb pallets Malaysia, ISPM-15 export pallets Selangor, paper pallet Balakong, wooden pallet alternative Klang Valley, fumigation-free pallets Cheras, export packaging Kajang" };
const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Are honeycomb pallets accepted for international export?","acceptedAnswer":{"@type":"Answer","text":"Yes — and they have a major advantage over wood. Honeycomb cardboard pallets are exempt from ISPM-15 fumigation requirements because they are not solid wood packaging material. This means no heat treatment stamp, no quarantine inspection, and faster customs clearance in EU, US, China, and Australia."}},{"@type":"Question","name":"How much weight can a honeycomb pallet carry?","acceptedAnswer":{"@type":"Answer","text":"Standard honeycomb pallets handle 500-1,500kg static load and 800kg dynamic load — comparable to a single-use wooden pallet. Heavy-duty configurations with reinforced runners reach 2,000kg+ static, suitable for machinery shipments."}},{"@type":"Question","name":"What does a honeycomb pallet weigh compared to wooden?","acceptedAnswer":{"@type":"Answer","text":"A standard wooden pallet weighs 20-25kg; an equivalent honeycomb pallet weighs 5-8kg. On air freight that 15kg saving per pallet directly cuts cost. On sea freight it lets you fit more product per container by chargeable weight."}},{"@type":"Question","name":"Are honeycomb pallets reusable?","acceptedAnswer":{"@type":"Answer","text":"They handle 3-5 round trips in dry indoor conditions and one-way export use. They are not designed for outdoor yard storage like a CHEP wooden pallet — moisture is the limiting factor."}},{"@type":"Question","name":"Are they cost-competitive with single-use wooden pallets?","acceptedAnswer":{"@type":"Answer","text":"On per-unit price wooden is cheaper. But once you add ISPM-15 fumigation cost (RM 25-50 per pallet), heat-treatment certification, and air freight weight savings, honeycomb often wins on total landed cost — especially for export shipments to fumigation-strict markets."}}]};
