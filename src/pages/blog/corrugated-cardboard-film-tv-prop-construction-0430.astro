const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Why is corrugated cardboard used for film and event sets?","acceptedAnswer":{"@type":"Answer","text":"Corrugated cardboard is the gold standard for fast-turnaround set construction because it is lightweight, paintable, easy to cut with a utility knife, structurally rigid when scored and folded, and cheap to dispose of after the shoot. Unlike plywood, you do not need power tools or trained carpenters to shape it — a production designer with a sharp blade can build a façade in a weekend."}},{"@type":"Question","name":"What sheet sizes are best for set walls and prop construction?","acceptedAnswer":{"@type":"Answer","text":"Standard 1200×2400mm (4ft × 8ft) sheets match plywood dimensions and slot easily into typical set-wall framing. For prop construction, 1000×1500mm sheets give more flexibility. We supply both sizes in BC double-wall (7mm) for structural pieces and single-wall (3mm) for prop facing and lightweight cutouts."}},{"@type":"Question","name":"Can cardboard sheets be painted with set paints?","acceptedAnswer":{"@type":"Answer","text":"Yes. Standard set-design acrylic paint, latex emulsion, and spray paint all adhere well. For best surface coverage, prime first with a thin water-based primer or PVA-and-water 1:1 mix to seal the kraft surface. After priming, the cardboard takes paint identically to gypsum board or MDF, making it ideal for matching painted set finishes."}},{"@type":"Question","name":"How much weight can a cardboard set wall hold?","acceptedAnswer":{"@type":"Answer","text":"A scored-and-folded BC double-wall sheet, supported by a simple wood or PVC frame, easily holds dressing weight (paintings, light fixtures up to 2kg, decorative shelves). For load-bearing or actor-leaning surfaces, sandwich two BC sheets back-to-back with a wood internal stud frame — that gives plywood-equivalent rigidity at a fraction of the weight."}},{"@type":"Question","name":"How quickly can you supply for a production deadline?",
"acceptedAnswer":{"@type":"Answer","text":"For pallet-quantity orders (20-100 sheets) we typically dispatch within one working day from Balakong if items are in stock. For custom-cut shapes or printed sheets, lead time is 3-5 working days. Productions shooting in KL, Cheras, Kajang, or Setapak can usually arrange same-week pickup or delivery — just WhatsApp the spec."}}]};
