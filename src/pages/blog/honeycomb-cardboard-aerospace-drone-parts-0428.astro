const articleSchema = { "@context":"https://schema.org","@type":"Article", headline: post.title, description: post.description, datePublished: '2026-04-28', dateModified: '2026-04-28', inLanguage:"en-MY", author:{name:"Quinocycle Team",url:"https://www.quinocycle.com.my"}, publisher:{name:"Quinocycle Sdn. Bhd.",logo:{url:"https://www.quinocycle.com.my/logo.png"}}, mainEntityOfPage:{url:"https://www.quinocycle.com.my/blog/honeycomb-cardboard-aerospace-drone-parts-0428"}, keywords:"aerospace packaging Malaysia, drone shipping honeycomb Selangor, UAV airframe protection Balakong, MRO packaging Kajang, avionics shipping cardboard, ASEAN drone export packaging" };
const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Why honeycomb cardboard for drone and aerospace shipments?","acceptedAnswer":{"@type":"Answer","text":"Drones, airframes, and avionics are vibration-sensitive but also weight-sensitive — every gram matters in air freight. Honeycomb cardboard absorbs in-transit shocks like foam without adding the weight or the recycling problem. It's the standard packaging media for many aerospace MRO operations globally."}},{"@type":"Question","name":"Can honeycomb meet aerospace export requirements?","acceptedAnswer":{"@type":"Answer","text":"Yes. Our honeycomb sheets meet ISTA-3A vibration standards and are accepted by air-freight forwarders for general aerospace components. For DG (dangerous goods) shipments — lithium batteries in drones, for example — please confirm the outer packaging meets your specific UN spec."}},{"@type":"Question","name":"What thickness for a foldable drone airframe?","acceptedAnswer":{"@type":"Answer","text":"25mm honeycomb is standard for consumer-grade folding drones. For commercial inspection drones with extended booms (DJI Matrice class), step up to 40mm honeycomb on top and bottom plus edge frames. We custom-cut to match your airframe profile."}},{"@type":"Question","name":"Do you supply small batches for drone startups?","acceptedAnswer":{"@type":"Answer","text":"Yes, as long as you hit the RM 1,000 minimum. Combine honeycomb panels with carton outers, foam inserts, and ESD bags into one order — common for drone makers shipping pilot units to ASEAN customers."}},{"@type":"Question","name":"Can you custom-cut honeycomb to airframe geometry?","acceptedAnswer":{"@type":"Answer","text":"Yes — we CNC-cut honeycomb to fit complex airframe shapes, including motor cradles and propeller pockets. Send us your dimensioned drawings and we'll quote with a 7–10 day lead time."}}]};
