          </div>
          <div>
            <p class="font-label text-primary font-bold text-sm mb-2">COMMERCIAL INSPECTION UAV</p>
            <p class="font-body text-on-surface text-sm">40mm custom-cut cradle | airframe-fit</p>
          </div>
          <div>
            <p class="font-label text-primary font-bold text-sm mb-2">AVIONICS UNIT</p>
