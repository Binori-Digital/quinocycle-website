const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "吉隆坡/雪兰莪哪里买搬家纸箱最便宜？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "最便宜的方式是直接向纸箱批发仓库购买，跳过零售中间商。五金店或文具店一个纸箱通常卖RM8–12，而Quinocycle位于雪兰莪Balakong的批发仓库，二手纸箱价格从RM0.90起（目前现货最低RM1.70，库存会轮换），全新纸箱从RM1.10起。KL和雪兰莪订单满RM300免运费，也可以自取。"
      }
    },
    {
      "@type": "Question",
      "name": "二手纸箱干净吗？可以用来搬家吗？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "可以。Quinocycle的二手纸箱是一次性使用的工厂级纸箱 — 只被工厂使用过一次，之后逐个检查，必须干燥、无异味、结构完好才会出售。搬家只需要纸箱撑几天，二手纸箱是性价比最高的选择，价格通常只有全新纸箱的一半左右。"
      }
    },
    {
      "@type": "Question",
      "name": "三房式的家需要多少个搬家纸箱？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "三房式（3房）住家一般需要50–70个纸箱。单身公寓或一房式约15–25个，两房式约30–45个，四房式或有地住宅可能需要70–100个。建议以中号纸箱为主，重物（书本、厨具）用小号，轻而大的物品（棉被、枕头、衣服）才用大号。"
      }
    },
    {
      "@type": "Question",
      "name": "怎样向Quinocycle订购纸箱？可以用中文吗？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "两个方式：(1) WhatsApp 016-891 6381，发送你需要的尺寸和数量，我们会回复报价和现货情况 — 客服以英文/马来文回复最快，中文讯息我们也欢迎，会通过翻译处理；(2) 直接上网店 shop.quinocycle.com 下单。批发订单最低RM1,000，小数量（如一次搬家）请直接WhatsApp询价。KL和雪兰莪订单满RM300免运费。"
