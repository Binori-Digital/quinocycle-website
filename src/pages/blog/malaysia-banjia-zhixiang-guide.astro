---
import Layout from '../../layouts/Layout.astro';

const post = {
  title: '马来西亚搬家纸箱指南 — 吉隆坡/雪兰莪哪里买纸箱最便宜？',
  description: '搬家纸箱去哪里买最便宜？五金店一个纸箱要RM8–12，批发仓库二手纸箱从RM0.90起。二手 vs 全新纸箱对比、三房式约需50–70个纸箱、真实价格表、打包技巧 — 来自雪兰莪Balakong纸箱批发仓库的实用指南。',
  date: '2026-08-20',
  readTime: '8 分钟',
  category: '搬家指南',
  author: 'Quinocycle 团队',
  slug: 'malaysia-banjia-zhixiang-guide',
};

const WA_LINK = 'https://wa.me/60168916381?text=Hi%20Quinocycle!%20I%20would%20like%20to%20ask%20about%20moving%20boxes%20%2F%20carton%20boxes.';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "description": post.description,
  "datePublished": post.date,
  "dateModified": post.date,
  "inLanguage": "zh-MY",
  "author": {
    "@type": "Organization",
    "name": "Quinocycle Sdn. Bhd.",
    "url": "https://www.quinocycle.com.my"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Quinocycle",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.quinocycle.com.my/logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://www.quinocycle.com.my/blog/malaysia-banjia-zhixiang-guide"
  },
  "image": {
    "@type": "ImageObject",
    "url": "https://www.quinocycle.com.my/images/blog-movers-guide.jpg",
    "width": 1280,
    "height": 720
  },
  "keywords": "搬家纸箱, 纸箱 马来西亚, 二手纸箱, 纸箱批发, 吉隆坡纸箱, 雪兰莪纸箱, 搬家箱子, 纸皮箱, Quinocycle Balakong"
