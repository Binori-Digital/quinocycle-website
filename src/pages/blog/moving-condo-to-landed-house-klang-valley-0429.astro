import Layout from '../../layouts/Layout.astro';
const post = { title: 'Moving from Condo to Landed House — Klang Valley Packing Guide & Box Estimator', description: 'Upgrading from a condo to a landed house in Selangor or KL? Practical packing tips, box quantity estimator, and Quinocycle wholesale supply for Klang Valley families.', date: '2026-04-29', readTime: '7 min', category: 'Moving House Tips', author: 'Quinocycle Team', slug: 'moving-condo-to-landed-house-klang-valley-0429' };
const WA_LINK = 'https://wa.me/60168916381?text=Hi%20Quinocycle!%20I%20am%20moving%20from%20condo%20to%20landed%20house%20and%20need%20boxes.';
const articleSchema = { "@context":"https://schema.org","@type":"Article", headline: post.title, description: post.description, datePublished: '2026-04-29', dateModified: '2026-04-29', inLanguage:"en-MY", author:{name:"Quinocycle Team",url:"https://www.quinocycle.com.my"}, publisher:{name:"Quinocycle Sdn. Bhd.",logo:{url:"https://www.quinocycle.com.my/logo.png"}}, mainEntityOfPage:{url:"https://www.quinocycle.com.my/blog/moving-condo-to-landed-house-klang-valley-0429"}, keywords:"condo to landed house move Malaysia, Klang Valley moving boxes, Selangor home upgrade packing, KL house move boxes Cheras, Kajang relocation supplies, family move Balakong" };
const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How many boxes do I need to move from a 1000sqft condo to a landed house?","acceptedAnswer":{"@type":"Answer","text":"Plan for 60-90 mixed boxes. The move-out side of a condo is more compact, but the move-in side often expands — landed houses absorb stuff that was hidden in condo storage compartments. Order the higher end of the range; surplus boxes are useful for the inevitable storeroom unpacking month."}},{"@type":"Question","name":"What's different about packing for a landed move vs condo-to-condo?","acceptedAnswer":{"@type":"Answer","text":"Landed houses involve outdoor items (garden tools, BBQ, outdoor furniture), often a separate utility/wet kitchen with bulky items, and frequently a need for short-term storage of things you'll only unpack once you've decided where they live. Plan a 'staging zone' in the new house — usually the garage or porch — for boxes you'll deal with later."}},{"@type":"Question","name":"Should I move myself or hire movers when going to a landed house?","acceptedAnswer":{"@type":"Answer","text":"Most condo-to-landed moves benefit from at least a partial mover engagement — typically for the heavy furniture, fridge, washing machine, and bed frames. Personal items, books, kitchen, and clothes are reasonable to self-pack and self-transport with a hired van."}},{"@type":"Question","name":"How early should I order packing boxes?","acceptedAnswer":{"@type":"Answer","text":"Order 2-3 weeks before move date. Pack non-essentials immediately (out-of-season clothes, books, decor). Do daily-use items in the final week. The mistake people make is leaving everything to the last weekend — half a Klang Valley move-out happens at midnight on a Sunday."}},{"@type":"Question","name":"Can I bundle boxes, bubble wrap, and tape in one Quinocycle order?","acceptedAnswer":{"@type":"Answer","text":"Yes — that's how most family moves hit our RM 1,000 minimum. A typical bundle: 80 mixed boxes, 10 hanging garment boxes, 100m bubble wrap roll, 12 rolls packing tape, 1 stretch film roll. Delivered to your condo lobby in one trip."}}]};
const localBusinessSchema = { "@context":"https://schema.org","@type":"Store", name:"Quinocycle Sdn. Bhd.", url:"https://www.quinocycle.com.my", telephone:"+60168916381", address:{streetAddress:"No.13, Jalan Taming P/1, Taming Jaya", addressLocality:"Balakong", addressRegion:"Selangor", postalCode:"43300", addressCountry:"MY"}, geo:{latitude:3.0579,longitude:101.7468}, openingHoursSpecification:[{dayOfWeek:["Monday","Tuesday","Wednesday","Thursday","Friday"],opens:"09:00",closes:"17:00"},{dayOfWeek:"Saturday",opens:"09:00",closes:"13:00"}], priceRange:"RM 1.90 – RM 6.50 per box", areaServed:"Peninsular Malaysia" };
---
<Layout title={post.title} description={post.description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <article class="max-w-4xl mx-auto px-6 md:px-8 pt-16 pb-24">
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-4">
        <span class="bg-primary/20 text-primary font-label font-bold text-xs uppercase tracking-widest px-3 py-1 rounded-full">{post.category}</span>
        <time class="font-body text-sm text-secondary">{post.date}</time>
      </div>
      <h1 class="font-headline text-3xl md:text-4xl font-extrabold tracking-tighter text-on-surface mb-4">{post.title}</h1>
      <p class="font-body text-lg text-secondary leading-relaxed">{post.description}</p>
    </header>

    <div class="prose prose-lg max-w-none">
      <section class="mb-12">
        <p class="font-body text-on-surface leading-relaxed mb-6">Moving up from a condo to a landed house is one of the most common Klang Valley life moves — Cheras, Kajang, Subang Jaya, Bandar Sri Damansara, Setia Alam. The math seems straightforward: you have less stuff, the new place has more space, easy. The reality is messier. Condos hide enormous amounts of compact storage (under-bed boxes, ceiling-height wardrobes, kitchen cabinet pull-outs) that all needs to come out and be repacked. And the new house feels empty for the first week, which prompts a "we need to buy more stuff" panic that you should resist. Here's a practical, Klang-Valley-specific guide.</p>
      </section>

      <section class="mb-12">
        <h2 class="font-headline text-2xl font-bold text-on-surface mb-6">Sizing the Move</h2>
        <h3 class="font-headline text-xl font-bold text-on-surface mb-4">Box Quantity by Condo Size</h3>
        <p class="font-body text-on-surface leading-relaxed mb-6">A 1-bedroom 700sqft condo: 40-60 boxes. A 3-bedroom 1,200sqft condo: 60-90 boxes. A larger 1,500sqft+ condo: 90-130 boxes. Add 10-15 hanging wardrobe boxes for garments still on hangers, plus 30-50m of bubble wrap. We always recommend ordering at the higher end — surplus is useful for the unpacking month, when you find things that don't have a place yet.</p>

        <h3 class="font-headline text-xl font-bold text-on-surface mb-4">The Hidden Storage Audit</h3>
        <p class="font-body text-on-surface leading-relaxed mb-6">Before you order boxes, do a 30-minute audit of your hidden storage: under beds, top of wardrobes, kitchen cabinet upper rows, balcony storeroom, the air-cond ledge cupboard. This is where condo dwellers stash 30% of their possessions and forget. Add 20-30 boxes to your estimate after the audit.</p>

        <h3 class="font-headline text-xl font-bold text-on-surface mb-4">Box Sizing for Different Rooms</h3>
        <p class="font-body text-on-surface leading-relaxed mb-6">Books and documents: small boxes only (350x250x200mm) — large boxes get unliftable. Kitchen and crockery: medium boxes (450x350x300mm) with bubble wrap. Bedding, curtains, soft furnishings: large boxes (550x400x400mm). Wardrobe: hanging garment boxes for shirts and jackets, folded into medium for the rest.</p>
      </section>

      <section class="mb-12">
        <h2 class="font-headline text-2xl font-bold text-on-surface mb-6">The Packing Timeline That Actually Works</h2>
        <h3 class="font-headline text-xl font-bold text-on-surface mb-4">Three Weeks Out</h3>
        <p class="font-body text-on-surface leading-relaxed mb-6">Order packing supplies. Pack non-essentials: out-of-season clothes, books, decorative items, board games. Anything you can live without for three weeks gets boxed and labelled now. Half your stress in week three is people who put this off.</p>

        <h3 class="font-headline text-xl font-bold text-on-surface mb-4">One Week Out</h3>
        <p class="font-body text-on-surface leading-relaxed mb-6">Pack the kitchen down to "essentials only" — keep one pot, one pan, basic crockery for two days. Wrap and box electronics (TV, sound system, gaming consoles). Disassemble bed frames the day before move day, not the morning of.</p>

        <h3 class="font-headline text-xl font-bold text-on-surface mb-4">Move Day</h3>
        <p class="font-body text-on-surface leading-relaxed mb-6">First-night essentials box stays with you, not the movers — toiletries, phone chargers, change of clothes, basic kitchen for breakfast, important documents. Everything else goes in the truck. Write the destination room on every box for unpacking sanity at the new house.</p>
      </section>

      <section class="mb-12">
        <h2 class="font-headline text-2xl font-bold text-on-surface mb-6">Klang Valley-Specific Considerations</h2>
        <p class="font-body text-on-surface leading-relaxed mb-6">Condo move-outs need management approval and a booked service lift slot. Most condos restrict moves to weekday office hours, which means taking annual leave. Check parking restrictions at the new landed house — Cheras and Kajang gated guarded communities often need visitor passes pre-arranged for the moving truck. Distance: most condo-to-landed moves cover 5-25km, all within an afternoon.</p>
      </section>

      <div class="bg-surface-variant/50 border border-outline-variant/20 rounded-lg p-8 my-12">
        <h3 class="font-headline text-xl font-bold text-on-surface mb-6">Condo-to-Landed Box Estimator</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <p class="font-label text-primary font-bold text-sm mb-2">1-BEDROOM CONDO</p>
            <p class="font-body text-on-surface text-sm">40-60 boxes mixed</p>
          </div>
          <div>
            <p class="font-label text-primary font-bold text-sm mb-2">3-BEDROOM CONDO</p>
            <p class="font-body text-on-surface text-sm">60-90 boxes mixed</p>
          </div>
          <div>
            <p class="font-label text-primary font-bold text-sm mb-2">LARGE 1500SQFT+ CONDO</p>
            <p class="font-body text-on-surface text-sm">90-130 boxes mixed</p>
          </div>
          <div>
            <p class="font-label text-primary font-bold text-sm mb-2">HANGING GARMENTS</p>
            <p class="font-body text-on-surface text-sm">10-15 wardrobe boxes</p>
          </div>
        </div>
      </div>

      <section class="mb-12">
        <h2 class="font-headline text-2xl font-bold text-on-surface mb-6">Move FAQs</h2>
        <div class="space-y-4">
          <details class="group border border-outline-variant/20 rounded-lg p-4">
            <summary class="font-label font-bold text-on-surface cursor-pointer">How many boxes for a 1000sqft condo to landed?</summary>
            <p class="font-body text-on-surface text-sm mt-3 leading-relaxed">60-90 mixed boxes plus 10-15 hanging wardrobe boxes and 30-50m of bubble wrap.</p>
          </details>
          <details class="group border border-outline-variant/20 rounded-lg p-4">
            <summary class="font-label font-bold text-on-surface cursor-pointer">What's different about landed moves?</summary>
            <p class="font-body text-on-surface text-sm mt-3 leading-relaxed">Outdoor items, separate utility kitchen, more storage rooms to fill — and a need for staging zone in garage/porch.</p>
          </details>
          <details class="group border border-outline-variant/20 rounded-lg p-4">
            <summary class="font-label font-bold text-on-surface cursor-pointer">Should I hire movers or do it myself?</summary>
            <p class="font-body text-on-surface text-sm mt-3 leading-relaxed">Hybrid usually best — movers for heavy furniture and appliances; self-pack and transport for personal items.</p>
          </details>
          <details class="group border border-outline-variant/20 rounded-lg p-4">
            <summary class="font-label font-bold text-on-surface cursor-pointer">How early to order boxes?</summary>
            <p class="font-body text-on-surface text-sm mt-3 leading-relaxed">2-3 weeks before move date. Start packing non-essentials immediately.</p>
          </details>
          <details class="group border border-outline-variant/20 rounded-lg p-4">
            <summary class="font-label font-bold text-on-surface cursor-pointer">Can I bundle boxes, wrap, and tape in one order?</summary>
            <p class="font-body text-on-surface text-sm mt-3 leading-relaxed">Yes — most family moves hit our RM 1,000 minimum that way. One delivery to your condo lobby.</p>
          </details>
        </div>
      </section>

      <section class="mb-12 bg-primary/5 border border-primary/20 rounded-lg p-8">
        <h2 class="font-headline text-2xl font-bold text-on-surface mb-4">Klang Valley Move Bundles from Balakong</h2>
        <p class="font-body text-on-surface leading-relaxed mb-6">Tell us your condo size and move date — we'll bundle boxes, bubble wrap, tape, and stretch film into one wholesale order delivered to your lobby.</p>
        <p class="font-body text-on-surface mb-6"><strong>Contact Quinocycle today:</strong></p>
        <ul class="font-body text-on-surface text-sm space-y-2 mb-6">
          <li>📞 <strong>Phone:</strong> +60 16 8916 381 / 03-8962 6381</li>
          <li>📧 <strong>Email:</strong> quinocycle@gmail.com</li>
          <li>📍 <strong>Address:</strong> No.13, Jalan Taming P/1, Taming Jaya, Balakong, Selangor 43300</li>
        </ul>
        <a href={WA_LINK} class="inline-block bg-primary text-on-primary font-label font-bold text-sm px-6 py-3 rounded-lg hover:opacity-90 transition-opacity">💬 Chat on WhatsApp</a>
      </section>

      <section class="mb-8">
        <h2 class="font-headline text-2xl font-bold text-on-surface mb-4">Conclusion: Plan the Move, Not Just the House</h2>
        <p class="font-body text-on-surface leading-relaxed mb-4">Buying a landed house is the milestone. Getting your stuff there in one piece is the actual project. Order supplies early, audit hidden storage, label everything by destination room, and keep a first-night box with you. Boring advice, but it works.</p>
        <p class="font-body text-on-surface leading-relaxed">WhatsApp Quinocycle for your move bundle quote — we deliver across all major Klang Valley condos and gated communities.</p>
      </section>
    </div>
  </article>
</Layout>
