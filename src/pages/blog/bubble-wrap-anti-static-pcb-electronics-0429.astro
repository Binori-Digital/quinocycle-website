            <p class="font-body text-on-surface text-sm">10mm bubble | 500mm x 50m</p>
          </div>
          <div>
            <p class="font-label text-primary font-bold text-sm mb-2">MOTHERBOARD / LARGE BOARD</p>
            <p class="font-body text-on-surface text-sm">25mm bubble | 1000mm x 100m</p>
          </div>
          <div>
