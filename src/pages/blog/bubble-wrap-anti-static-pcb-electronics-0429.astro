const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What's the difference between pink anti-static and standard bubble wrap?","acceptedAnswer":{"@type":"Answer","text":"Pink anti-static bubble wrap is treated with an antistatic agent that prevents static charge accumulation on the surface. Standard clear bubble wrap can build up static during friction, which can damage sensitive components. Pink wrap dissipates charge safely; clear wrap can zap a chip."}},{"@type":"Question","name":"Is pink bubble wrap the same as ESD-safe?","acceptedAnswer":{"@type":"Answer","text":"Pink anti-static is the entry level — it prevents static buildup but doesn't actively shield from external electrostatic discharge (ESD). For high-value semiconductors and sensitive ICs, you need shielding bags (silver/black metallised) plus anti-static bubble wrap as a cushion layer."}},{"@type":"Question","name":"What sensitivity level needs anti-static wrap?","acceptedAnswer":{"@type":"Answer","text":"Class 1 ESDS items (sensitive below 1,000 volts) like MOSFETs, CMOS chips, EPROMs, and high-density memory always need anti-static. Class 2 (1,000-4,000V) like most modern ICs benefit. Class 3 above 4,000V — populated PCBs with discrete components — generally fine with standard wrap if briefly handled."}},{"@type":"Question","name":"How long does the anti-static treatment last?","acceptedAnswer":{"@type":"Answer","text":"Anti-static treatment is migratory — typically effective for 12-24 months from date of manufacture. We rotate stock to keep what we ship within this window. Print date is on every roll."}},{"@type":"Question","name":"Do you supply in roll size suitable for automated cushioning machines?","acceptedAnswer":{"@type":"Answer","text":"Yes — we supply 500mm and 1000mm wide rolls in 50m and 100m lengths, compatible with most semi-automatic cushioning equipment used in Penang and Klang Valley electronics packaging lines."}}]};
