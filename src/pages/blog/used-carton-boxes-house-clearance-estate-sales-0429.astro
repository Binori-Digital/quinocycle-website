const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How many used boxes do I need for a typical 3-bedroom house clearance?","acceptedAnswer":{"@type":"Answer","text":"Plan for 80-120 mixed boxes for a fully-furnished 3-bedroom home. About 30-40 small (book/crockery), 30-40 medium (kitchen/clothes), 20-30 large (bedding/cushions), plus 10-15 wardrobe-sized for hanging garments."}},{"@type":"Question","name":"Are the used boxes strong enough for delicate items?","acceptedAnswer":{"@type":"Answer","text":"Our used boxes are graded — only Grade A and B reach our wholesale buyers. They've held export-quality products on their first journey, so they're more than strong enough for household items. For breakables, pair with bubble wrap and butcher paper."}},{"@type":"Question","name":"Can you deliver same-day for an urgent house clearance?","acceptedAnswer":{"@type":"Answer","text":"Yes, subject to availability. WhatsApp us before 11am for same-day delivery to Cheras, Balakong, Kajang, Seri Kembangan, and Sungai Long. Other Klang Valley areas usually next day."}},{"@type":"Question","name":"Do you accept returns of unused boxes?","acceptedAnswer":{"@type":"Answer","text":"We don't offer cash refunds, but if you have surplus clean boxes after the clearance, we sometimes buy back at a discount. Contact us for current rates and minimum quantities."}},{"@type":"Question","name":"Is the RM 1,000 minimum order steep for a house clearance?","acceptedAnswer":{"@type":"Answer","text":"Most full-house clearances exceed RM 1,000 once you bundle boxes, bubble wrap, packing tape, and stretch film. For smaller jobs, partner with a moving company who can absorb your portion into their bulk order."}}]};
