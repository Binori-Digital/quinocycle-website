const articleSchema = { "@context":"https://schema.org","@type":"Article", headline: post.title, description: post.description, datePublished: '2026-04-28', dateModified: '2026-04-28', inLanguage:"en-MY", author:{name:"Quinocycle Team",url:"https://www.quinocycle.com.my"}, publisher:{name:"Quinocycle Sdn. Bhd.",logo:{url:"https://www.quinocycle.com.my/logo.png"}}, mainEntityOfPage:{url:"https://www.quinocycle.com.my/blog/new-carton-boxes-pet-supplies-vet-clinics-0428"}, keywords:"pet supplies packaging Malaysia, vet clinic carton boxes Selangor, pet food distributor boxes Balakong, dog food shipping cartons, cat litter wholesale boxes, aquarium supplies packaging Kajang" };
const faqSchema = { "@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Are your carton boxes food-grade enough for pet food?","acceptedAnswer":{"@type":"Answer","text":"Yes. Our new kraft carton boxes use virgin liner that meets the same hygiene benchmarks as human food packaging. They're suitable for sealed pet food bags, treat pouches, and supplement bottles. For loose dry food we recommend a sealed inner liner."}},{"@type":"Question","name":"What box strength do I need for 15kg dog food bags?","acceptedAnswer":{"@type":"Answer","text":"5-ply double-wall corrugated cartons are our standard recommendation for 15–20kg dog or cat food. Single-wall 3-ply works for 5kg bags. We can size cartons to fit one, two, or four bags per outer."}},{"@type":"Question","name":"Do you supply small quantities for independent vet clinics?","acceptedAnswer":{"@type":"Answer","text":"Our minimum order is RM 1,000. Most independent clinics meet this by combining boxes, bubble wrap, and tape into one order. Bundle pricing keeps the unit cost competitive even at smaller volumes."}},{"@type":"Question","name":"Can boxes be printed with my pet store branding?","acceptedAnswer":{"@type":"Answer","text":"Yes. We offer 1–4 colour flexo printing for orders above 1,000 boxes. Common pet brand assets — paw prints, mascot, contact details — print cleanly on kraft. Lead time is 7–10 working days from artwork approval."}},{"@type":"Question","name":"Do you deliver to vet clinics across the Klang Valley?","acceptedAnswer":{"@type":"Answer","text":"Yes. We deliver to vet clinics, pet stores, and groomers across Cheras, Kajang, Seri Kembangan, Subang, Petaling Jaya, and central KL. Free delivery thresholds and timing vary by area — WhatsApp us for a quote."}}]};
